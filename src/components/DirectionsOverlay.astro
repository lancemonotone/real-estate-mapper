---
/**
 * Shared directions modal markup. Include once per page that opens routes.
 * Script: /scripts/directions-overlay.js
 */
import IconGlyph from './IconGlyph.astro';
---
<div
  id="directions-overlay"
  class="directions-overlay"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="directions-overlay-title"
>
  <div class="directions-overlay__backdrop" data-overlay-close></div>
  <div class="directions-overlay__panel glass">
    <header class="directions-overlay__header">
      <h2 id="directions-overlay-title">Route</h2>
      <button type="button" class="secondary icon-btn" data-overlay-close aria-label="Close" title="Close">
        <IconGlyph name="x" />
      </button>
    </header>
    <p id="directions-overlay-meta" class="directions-overlay__meta muted"></p>
    <div id="directions-overlay-map" class="directions-overlay__map map-well"></div>
    <p class="directions-overlay__actions">
      <a
        id="directions-overlay-external"
        class="secondary icon-btn"
        href="#"
        target="_blank"
        rel="noopener"
        aria-label="Open in Google Maps"
        title="Open in Google Maps"
      >
        <IconGlyph name="mapPin" />
      </a>
    </p>
    <p id="directions-overlay-error" class="alert" hidden></p>
  </div>
</div>
