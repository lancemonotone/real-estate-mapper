---
import IconGlyph from './IconGlyph.astro';

interface Props {
  listingId: string;
  favorited?: boolean;
  passed?: boolean;
  /** Flatten into parent flex (detail header). Cards keep stacked wrapper. */
  inline?: boolean;
}

const { listingId, favorited = false, passed = false, inline = false } = Astro.props;
---
<div class:list={['listing-reactions', { 'listing-reactions--inline': inline }]}>
  <button
    type="button"
    class="listing-favorite"
    data-favorite-toggle
    data-listing-id={listingId}
    aria-pressed={favorited ? 'true' : 'false'}
    aria-label={favorited ? 'Remove favorite' : 'Favorite'}
    title={favorited ? 'Favorited' : 'Favorite'}
  >
    <IconGlyph name="heart" />
  </button>
  <button
    type="button"
    class="listing-favorite listing-passed"
    data-passed-toggle
    data-listing-id={listingId}
    aria-pressed={passed ? 'true' : 'false'}
    aria-label={passed ? 'Remove passed mark' : 'Mark as passed'}
    title={passed ? 'Passed' : 'Pass'}
  >
    <IconGlyph name="thumbsDown" />
  </button>
</div>
