---
import IconGlyph from './IconGlyph.astro';

interface Props {
  listingId: string;
  favorited?: boolean;
}

const { listingId, favorited = false } = Astro.props;
---
<button
  type="button"
  class="listing-favorite"
  data-favorite-toggle
  data-listing-id={listingId}
  aria-pressed={favorited ? 'true' : 'false'}
  aria-label={favorited ? 'Remove favorite' : 'Favorite'}
  title={favorited ? 'Favorited' : 'Favorite'}
>
  <IconGlyph name="heart" />
</button>
