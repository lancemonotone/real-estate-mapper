---
import type { Listing } from '../lib/types/database';
import { listingBadges } from '../lib/listings/badges';
import {
  resolveListingTourDateInput,
  resolveListingTourTimeInput,
} from '../lib/tours/listing-tour-date';

interface Props {
  listing?: Partial<Listing>;
  tourAssignment?: { tourDate: string; appointmentTime?: string | null } | null;
  action: string;
  submitLabel: string;
  localeId?: string;
}

const { listing = {}, tourAssignment = null, action, submitLabel, localeId } = Astro.props;
const tourDateValue = resolveListingTourDateInput(
  tourAssignment,
  listing.appointment_at ?? null,
);
const tourTimeValue = resolveListingTourTimeInput(
  tourAssignment,
  listing.appointment_at ?? null,
);
const badges = listing.id
  ? listingBadges(listing as Listing)
  : [];
const initialPhotoUrls =
  listing.photo_urls && listing.photo_urls.length > 0
    ? listing.photo_urls
    : listing.photo_url
      ? [listing.photo_url]
      : [];
---
{badges.length > 0 && (
  <ul>
    {badges.map((b) => (
      <li>{b}</li>
    ))}
  </ul>
)}
<form method="post" action={action} enctype="multipart/form-data" class="listing-form stack">
  {listing.id && <input type="hidden" name="id" value={listing.id} />}
  {localeId && <input type="hidden" name="locale_id" value={localeId} />}
  <label>Name <input name="name" value={listing.name ?? ''} /></label>
  <label>Address <input name="address" value={listing.address ?? ''} /></label>
  <label>Phone <input name="phone" type="tel" autocomplete="tel" value={listing.phone ?? ''} /></label>
  <label>Source URL <input name="source_url" type="url" value={listing.source_url ?? ''} /></label>
  <fieldset class="listing-form__gallery" data-gallery-form>
    <legend>Photos</legend>
    <p class="muted listing-form__gallery-hint">
      Drag to reorder. First photo is the primary thumb.
    </p>
    <ul class="listing-form__gallery-list" data-gallery-list>
      {initialPhotoUrls.map((url) => (
        <li class="listing-form__gallery-item" data-gallery-item draggable="true">
          <input type="hidden" name="photo_urls" value={url} />
          <img src={url} alt="" draggable="false" />
          <button
            type="button"
            class="secondary icon-btn listing-form__gallery-remove"
            data-gallery-remove
            aria-label="Remove photo"
            title="Remove photo"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12"></path>
              <path d="M18 6L6 18"></path>
            </svg>
          </button>
        </li>
      ))}
    </ul>
    <label>
      Add photo URL(s)
      <textarea
        data-gallery-add
        rows="2"
        placeholder="One https URL per line"
      ></textarea>
    </label>
    <button type="button" class="secondary" data-gallery-add-btn>
      Add
    </button>
  </fieldset>
  <label>Upload photo <input name="photo" type="file" accept="image/*" /></label>
  <div class="listing-form__tour">
    <label>
      Tour date
      <input name="tour_date" type="date" value={tourDateValue} />
    </label>
    <label class="listing-form__tour-time">
      <span class="visually-hidden">Tour time</span>
      <input
        name="tour_time"
        type="time"
        class="tours-stops__time"
        value={tourTimeValue}
      />
    </label>
  </div>
  <label>Notes <textarea name="notes">{listing.notes ?? ''}</textarea></label>

  <fieldset class="listing-form__attrs">
    <legend>Attributes</legend>
    <label>
      Price / mo
      <input
        name="price_monthly"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        value={listing.price_monthly ?? ''}
      />
    </label>
    <label>
      Deposit
      <input
        name="deposit"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        value={listing.deposit ?? ''}
      />
    </label>
    <label>
      Fees / mo
      <input
        name="fees_monthly"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        value={listing.fees_monthly ?? ''}
      />
    </label>
    <label>
      Sq ft
      <input name="sqft" type="number" inputmode="numeric" step="1" min="0" value={listing.sqft ?? ''} />
    </label>
    <label>
      Beds
      <input name="beds" type="number" inputmode="decimal" step="0.5" min="0" value={listing.beds ?? ''} />
    </label>
    <label>
      Baths
      <input name="baths" type="number" inputmode="decimal" step="0.5" min="0" value={listing.baths ?? ''} />
    </label>
    <label>
      Pet rent / mo
      <input
        name="pet_rent_monthly"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        value={listing.pet_rent_monthly ?? ''}
      />
    </label>
    <label>
      Pet deposit
      <input
        name="pet_deposit"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        value={listing.pet_deposit ?? ''}
      />
    </label>
    <label>
      Amenities
      <input
        name="amenities"
        type="text"
        placeholder="comma-separated, e.g. pool, gym"
        value={(listing.amenities ?? []).join(', ')}
      />
    </label>
  </fieldset>

  <div class="listing-form__actions">
    <button type="submit">{submitLabel}</button>
    <slot name="actions" />
  </div>
</form>
<style>
  .listing-form {
    --form-gap: 1rem;
    gap: var(--form-gap);
    margin-block: 1.5rem;

    @media (min-width: 768px) {
      --form-gap: 1.15rem;
    }
  }

  .listing-form__actions {
    --actions-gap: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--actions-gap);
    padding-block-start: 0.35rem;
  }

  .listing-form__tour {
    --tour-gap: 0.75rem;
    --tour-cols: 1fr;

    display: grid;
    grid-template-columns: var(--tour-cols);
    gap: var(--tour-gap);
    align-items: end;

    @media (min-width: 768px) {
      --tour-cols: 1fr auto;
    }
  }

  .listing-form__tour-time {
    display: inline-flex;
    align-items: center;
    margin: 0;
  }

  .listing-form__attrs {
    --attrs-gap: 0.85rem;
    --attrs-cols: 1fr;

    margin: 0;
    padding: 0.85rem 1rem 1rem;
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    background: var(--glass-wash);
    display: grid;
    grid-template-columns: var(--attrs-cols);
    gap: var(--attrs-gap);

    & legend {
      font-family: var(--font-display);
      font-weight: 600;
      padding-inline: 0.35rem;
    }

    & label:last-of-type {
      grid-column: 1 / -1;
    }

    @media (min-width: 768px) {
      --attrs-cols: 1fr 1fr;
      --attrs-gap: 1rem;
    }
  }

  .listing-form__gallery {
    --gallery-gap: 0.75rem;
    --gallery-cols: 2;
    --gallery-tile: 5.5rem;

    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);

    @media (min-width: 768px) {
      --gallery-cols: 4;
      --gallery-tile: 6.25rem;
    }

    @media (min-width: 1024px) {
      --gallery-cols: 5;
    }
  }

  .listing-form__gallery-hint {
    margin: 0;
    font-size: 0.9rem;
  }

  .listing-form__gallery-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--gallery-cols), var(--gallery-tile));
    gap: 0.55rem;
  }

  .listing-form__gallery-item {
    position: relative;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    overflow: hidden;
    cursor: grab;
    aspect-ratio: 1;
    inline-size: var(--gallery-tile);
    block-size: var(--gallery-tile);

    &:active {
      cursor: grabbing;
    }

    &.is-dragging {
      opacity: 0.45;
    }

    &.is-drag-over {
      border-color: var(--border-accent);
      outline: 2px solid var(--accent, var(--border-accent));
      outline-offset: 1px;
    }

    & img {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      pointer-events: none;
    }
  }

  .listing-form__gallery-remove {
    --control-pad-block: 0.2rem;
    --control-pad-inline: 0.2rem;
    --icon-size: 0.95rem;

    position: absolute;
    inset-block-start: 0.25rem;
    inset-inline-end: 0.25rem;
    min-inline-size: 1.65rem;
    min-block-size: 1.65rem;
    z-index: 1;
  }
</style>
<script>
  import { bindListingGalleryForm } from '../client/listing-gallery-form';
  bindListingGalleryForm();
</script>
