---
import IconGlyph from './IconGlyph.astro';

interface DayMeta {
  id: string;
  stopCount: number;
}

interface Props {
  weekKeys: string[];
  daysByDate: Record<string, DayMeta>;
  selectedDate: string | null;
  idPrefix?: string;
  weekLabel?: string;
  /** ISO date for the week jump picker value (usually week start or selected day). */
  jumpValue?: string;
  /** When true, empty cells cannot accept the first stop on a new tour day. */
  blockNewTourDays?: boolean;
  /** Per-date drop blocks (hidden tour days). */
  dropBlocked?: Record<string, 'cap' | 'hidden'>;
}

const {
  weekKeys,
  daysByDate,
  selectedDate,
  idPrefix = 'tour-week',
  weekLabel = 'Week',
  jumpValue = weekKeys[0] ?? '',
  blockNewTourDays = false,
  dropBlocked = {},
} = Astro.props;

const weekdayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const markedDates = Object.entries(daysByDate)
  .filter(([, meta]) => meta.stopCount > 0)
  .map(([key]) => key)
  .join(',');

function dayNum(key: string): string {
  const parts = key.split('-');
  return String(Number(parts[2] ?? '0'));
}
---
<div
  class="tour-week"
  data-tour-week
  id={idPrefix}
  data-tour-marked-dates={markedDates}
>
  <div class="tour-week__nav">
    <button type="button" class="secondary icon-btn" data-tour-week-prev aria-label="Previous week">
      <IconGlyph name="chevronLeft" />
    </button>
    <button
      type="button"
      class="tour-week__label"
      data-tour-week-jump
      title="Jump to a date"
      aria-label={`Week of ${weekLabel}. Click to jump to a date.`}
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls={`${idPrefix}-jump-popover`}
    >
      {weekLabel}
    </button>
    <div
      id={`${idPrefix}-jump-popover`}
      class="tour-week__jump-popover glass"
      data-tour-week-jump-popover
      hidden
      role="dialog"
      aria-label="Jump to date"
    >
      <div class="tour-week__jump-popover-nav">
        <button
          type="button"
          class="secondary icon-btn"
          data-jump-month-prev
          aria-label="Previous month"
        >
          <IconGlyph name="chevronLeft" />
        </button>
        <span class="tour-week__jump-month-label" data-jump-month-label></span>
        <button
          type="button"
          class="secondary icon-btn"
          data-jump-month-next
          aria-label="Next month"
        >
          <IconGlyph name="chevronRight" />
        </button>
      </div>
      <div class="tour-week__jump-popover-grid" data-jump-month-grid></div>
    </div>
    <input
      type="date"
      class="tour-week__jump-input"
      data-tour-week-jump-input
      value={jumpValue}
      tabindex="-1"
      aria-hidden="true"
    />
    <button type="button" class="secondary icon-btn" data-tour-week-next aria-label="Next week">
      <IconGlyph name="chevronRight" />
    </button>
    <button
      type="button"
      class="secondary icon-btn"
      data-tour-week-info
      aria-label="How scheduling works"
      title="How scheduling works"
    >
      <span aria-hidden="true">i</span>
    </button>
  </div>
  <div class="tour-week__grid" role="grid" aria-label="Tour week">
    {
      weekKeys.map((key, i) => {
        const meta = daysByDate[key];
        const selected = selectedDate === key;
        const hasTour = Boolean(meta && meta.stopCount > 0);
        const dropBlockedReason =
          dropBlocked[key] ?? (!hasTour && blockNewTourDays ? 'cap' : undefined);
        return (
          <button
            type="button"
            class:list={[
              'tour-week__cell',
              selected && 'is-selected',
              hasTour && 'has-tour',
              dropBlockedReason === 'cap' && 'tour-week__cell--drop-blocked',
              dropBlockedReason === 'hidden' && 'tour-week__cell--drop-hidden',
            ]}
            role="gridcell"
            data-tour-date={key}
            data-tour-day-id={meta?.id ?? ''}
            data-stop-count={meta?.stopCount ?? 0}
            data-drop-blocked={dropBlockedReason ?? undefined}
            aria-pressed={selected ? 'true' : 'false'}
            aria-disabled={dropBlockedReason ? 'true' : undefined}
            aria-label={`${weekdayLabels[i]} ${key}${hasTour ? `, ${meta!.stopCount} stops` : ''}${dropBlockedReason === 'cap' ? ', tour day limit reached' : ''}${dropBlockedReason === 'hidden' ? ', hidden on Free plan' : ''}`}
          >
            <span class="tour-week__weekday">{weekdayLabels[i]}</span>
            <span class="tour-week__daynum">{dayNum(key)}</span>
            {
              hasTour ? (
                <span
                  class="tour-week__dot"
                  data-tour-day-dot
                  draggable="true"
                  title="Drag to move this tour day"
                >
                  {meta!.stopCount}
                </span>
              ) : (
                <span class="tour-week__dot tour-week__dot--empty" aria-hidden="true"></span>
              )
            }
          </button>
        );
      })
    }
  </div>
</div>
