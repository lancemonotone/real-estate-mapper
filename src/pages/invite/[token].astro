---
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { joinNestFromInvite } from '../../lib/supabase/nest';

const token = Astro.params.token;
if (!token) {
  return Astro.redirect('/');
}

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(`/invite/${token}`)}`);
}

const { joined, error: joinError } = await joinNestFromInvite(supabase, user.id, token);

if (joined && !joinError) {
  return Astro.redirect('/app');
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Invite — Wayhome</title>
  </head>
  <body>
    <h1>Join Nest</h1>
    {joinError && <p role="alert">{joinError}</p>}
    <p><a href="/app">Back to app</a></p>
  </body>
</html>
