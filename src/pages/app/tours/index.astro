---
import { getPrimaryWorkspaceId, ensureWorkspaceForUser } from '../../../lib/supabase/workspace';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;
let workspaceId = await getPrimaryWorkspaceId(supabase, user.id);
if (!workspaceId) workspaceId = await ensureWorkspaceForUser(supabase, user.id);

const { data: tours } = await supabase
  .from('tour_days')
  .select('*')
  .eq('workspace_id', workspaceId)
  .order('tour_date', { ascending: true });
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Tours</title>
  </head>
  <body>
    <p><a href="/app">← Workspace</a></p>
    <h1>Tour days</h1>
    <ul>
      {(tours ?? []).map((tour) => (
        <li>
          <a href={`/app/tours/${tour.id}`}>{tour.tour_date}{tour.label ? ` — ${tour.label}` : ''}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
