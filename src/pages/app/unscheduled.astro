---
import { getPrimaryWorkspaceId, ensureWorkspaceForUser } from '../../lib/supabase/workspace';
import { listingBadges } from '../../lib/listings/badges';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;
let workspaceId = await getPrimaryWorkspaceId(supabase, user.id);
if (!workspaceId) workspaceId = await ensureWorkspaceForUser(supabase, user.id);

const { data: assigned } = await supabase
  .from('tour_stops')
  .select('listing_id');

const assignedIds = new Set((assigned ?? []).map((a) => a.listing_id));

const { data: listings } = await supabase
  .from('listings')
  .select('*')
  .eq('workspace_id', workspaceId)
  .order('created_at', { ascending: false });

const unscheduled = (listings ?? []).filter((l) => !assignedIds.has(l.id));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Unscheduled</title>
  </head>
  <body>
    <p><a href="/app">← Workspace</a></p>
    <h1>Unscheduled pool</h1>
    <p>Assign to a tour day, or scratch-optimize without saving.</p>
    <form id="scratch-form">
      <fieldset>
        <legend>Scratch optimize</legend>
        {(unscheduled ?? []).map((listing) => (
          <label style="display:block">
            <input type="checkbox" name="listing" value={listing.id} />
            {listing.name || listing.address || 'Untitled'}
            {listingBadges(listing).join(', ')}
          </label>
        ))}
        <label>
          Start listing id
          <select name="start" id="scratch-start">
            <option value="">Select start</option>
            {unscheduled.map((l) => (
              <option value={l.id}>{l.name || l.address || l.id}</option>
            ))}
          </select>
        </label>
        <button type="submit">Scratch optimize</button>
      </fieldset>
    </form>
    <pre id="scratch-result"></pre>
    <form id="promote-form" hidden>
      <label>Save as tour date <input type="date" name="tourDate" required /></label>
      <button type="submit">Save as tour day</button>
    </form>
    <h2>Assign one listing to a day</h2>
    <ul>
      {unscheduled.map((listing) => (
        <li>
          {listing.name || listing.address || 'Untitled'}
          <form method="post" action="/api/tours/assign" style="display:inline">
            <input type="hidden" name="listing_id" value={listing.id} />
            <input type="date" name="tour_date" required />
            <button type="submit">Assign</button>
          </form>
        </li>
      ))}
    </ul>
    <div id="map" data-map style="height:320px;margin-top:1rem"></div>
    <script>
      let lastResult = null;
      document.getElementById('scratch-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const ids = [...document.querySelectorAll('input[name="listing"]:checked')].map(
          (el) => el.value,
        );
        const startEl = document.getElementById('scratch-start');
        const startListingId = startEl instanceof HTMLSelectElement ? startEl.value : '';
        const res = await fetch('/api/tours/optimize', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scratchListingIds: ids, startListingId }),
        });
        lastResult = await res.json();
        const resultEl = document.getElementById('scratch-result');
        const promoteForm = document.getElementById('promote-form');
        if (resultEl) resultEl.textContent = JSON.stringify(lastResult, null, 2);
        if (promoteForm) promoteForm.hidden = !lastResult.ok;
      });
      document.getElementById('promote-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!lastResult?.ok) return;
        const tourDate = new FormData(e.target).get('tourDate');
        const res = await fetch('/api/tours/promote-scratch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tourDate,
            listingIdsInOrder: lastResult.orderedIds,
            startListingId: lastResult.orderedIds[0],
            legs: lastResult.legs,
            encodedPolyline: lastResult.encodedPolyline ?? null,
          }),
        });
        const data = await res.json();
        if (data.ok) location.href = `/app/tours/${data.tourDayId}`;
        else alert(data.error || 'Promote failed');
      });
    </script>
  </body>
</html>
