---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>New Locale — Wayhome</title>
  </head>
  <body>
    <h1>New Locale</h1>
    <p><a href="/app">Back to Nest</a></p>
    <form id="locale-form">
      <label>
        Name
        <input name="name" required placeholder="e.g. Tampa Bay" />
      </label>
      <label>
        Center place
        <input
          name="place"
          required
          placeholder="City, neighborhood, or address"
        />
      </label>
      <label>
        Radius (miles, optional — default ~15.5)
        <input name="radius_miles" type="number" step="any" min="0.1" />
      </label>
      <button type="submit">Create Locale</button>
    </form>
    <p id="error" hidden></p>
    <script>
      const form = document.getElementById('locale-form');
      const errorEl = document.getElementById('error');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        const fd = new FormData(form);
        const milesRaw = String(fd.get('radius_miles') ?? '').trim();
        const body = {
          name: String(fd.get('name') ?? ''),
          place: String(fd.get('place') ?? ''),
          ...(milesRaw ? { radius_miles: Number(milesRaw) } : {}),
        };
        const res = await fetch('/api/locales/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) {
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = data.error ?? 'Create failed';
          }
          return;
        }
        window.location.href = `/app/locales/${data.id}`;
      });
    </script>
  </body>
</html>
