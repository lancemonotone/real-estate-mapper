---
import AppLayout from '../../../layouts/AppLayout.astro';
import LocaleListingPrefsFields from '../../../components/LocaleListingPrefsFields.astro';
import PlanNotice from '../../../components/PlanNotice.astro';
import '../../../styles/locale-map.css';
import {
  DEFAULT_LOCALE_RADIUS_MILES,
  LOCALE_RADIUS_MILES_OPTIONS,
  milesToMeters,
} from '../../../lib/geo/locale-radius';
import {
  isLocaleCapReached,
  loadNestEntitlements,
  loadNestEntitlementUi,
  PLAN_MESSAGES,
} from '../../../lib/nest/entitlements';
import { ensureNestForUser, getPrimaryNestId } from '../../../lib/supabase/nest';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;

let nestId = await getPrimaryNestId(supabase, user.id);
if (!nestId) {
  nestId = await ensureNestForUser(supabase, user.id);
}

const devPreview = Astro.locals.devHuntPassPreview ?? false;
const snapshot = await loadNestEntitlements(supabase, nestId, { devHuntPassPreview: devPreview });
const entitlementUi = await loadNestEntitlementUi(supabase, nestId, user.id, devPreview);
const localeCapReached = snapshot ? isLocaleCapReached(snapshot) : false;
const localeCapMessage = snapshot ? PLAN_MESSAGES.localeCap(snapshot.plan) : '';
---
<AppLayout
  title="New Locale"
  crumbs={[{ href: '/app', label: 'Home' }, { label: 'New Locale' }]}
  nestId={nestId}
  entitlementUi={entitlementUi}
>
  <h1>New Locale</h1>

  {
    localeCapReached && entitlementUi && snapshot && (
      <PlanNotice
        variant="inline"
        isOwner={entitlementUi.isOwner}
        ownerDisplayName={entitlementUi.ownerDisplayName}
      >
        <p class="plan-notice__text">{localeCapMessage}</p>
      </PlanNotice>
    )
  }

  <section class="locale-browse">
    <div class="locale-browse__list stack">
      <div class="nest-tabs locale-form-tabs" data-nest-tabs>
        <nav
          class="locale-nav nest-tabs__bar"
          aria-label="Locale settings"
          data-nest-tabs-bar
          role="tablist"
        >
          <span class="locale-nav__pill" aria-hidden="true" data-nest-tabs-pill></span>
          <button
            type="button"
            class="button secondary locale-nav__link locale-nav__link--active"
            id="locale-tab-general"
            role="tab"
            aria-selected="true"
            aria-controls="locale-panel-general"
            tabindex="0"
            data-nest-tab="general"
          >
            General
          </button>
          <button
            type="button"
            class="button secondary locale-nav__link"
            id="locale-tab-import"
            role="tab"
            aria-selected="false"
            aria-controls="locale-panel-import"
            tabindex="-1"
            data-nest-tab="import"
          >
            Listing import
          </button>
        </nav>

        <form id="locale-form" class="stack locale-form-tabs__form">
          <div
            class="nest-tabs__panel stack"
            id="locale-panel-general"
            role="tabpanel"
            aria-labelledby="locale-tab-general"
            data-nest-tab-panel="general"
          >
            <label>
              Name
              <input
                name="name"
                id="locale-name"
                required
                placeholder="e.g. Tampa Bay"
                disabled={localeCapReached}
              />
            </label>
            <label>
              Center place
              <input
                name="place"
                id="locale-place"
                required
                placeholder="City, neighborhood, or address"
                disabled={localeCapReached}
              />
            </label>
            <label>
              Radius
              <select name="radius_miles" id="locale-radius" required disabled={localeCapReached}>
                {
                  LOCALE_RADIUS_MILES_OPTIONS.map((m) => (
                    <option value={m} selected={m === DEFAULT_LOCALE_RADIUS_MILES}>
                      {m} miles
                    </option>
                  ))
                }
              </select>
            </label>
          </div>

          <div
            class="nest-tabs__panel stack"
            id="locale-panel-import"
            role="tabpanel"
            aria-labelledby="locale-tab-import"
            data-nest-tab-panel="import"
            hidden
          >
            <LocaleListingPrefsFields prefs={null} showTitle={false} />
          </div>

          <button type="submit" disabled={localeCapReached}>Create Locale</button>
        </form>
      </div>

      <p id="error" class="alert" hidden></p>
    </div>

    <div class="locale-browse__map stack">
      <div
        id="locale-map"
        class="locale-map map-well locale-browse__map-well"
        data-key={import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? ''}
        data-map-id={import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? ''}
        data-radius-m={String(milesToMeters(DEFAULT_LOCALE_RADIUS_MILES))}
        data-title="New Locale"
      ></div>
      <p id="map-hint" class="locale-map-missing muted">Enter a place name to preview the map.</p>
    </div>
  </section>

  <script
    define:vars={{
      localeCapReached,
      localeCapMessage,
    }}
  >
    window.__WAYHOME_LOCALE_FORM__ = {
      mode: 'create',
      initialHasCenter: false,
      createBlocked: localeCapReached,
      blockedMessage: localeCapReached ? localeCapMessage : null,
    };
  </script>
  <script src="/scripts/locale-map.js" type="module"></script>
  <script src="/scripts/nest-tabs.js" type="module"></script>
  <script src="/scripts/locale-form.js" type="module"></script>
</AppLayout>
