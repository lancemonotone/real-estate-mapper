---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>New Locale — Wayhome</title>
  </head>
  <body>
    <h1>New Locale</h1>
    <p><a href="/app">Back to Nest</a></p>
    <form id="locale-form">
      <label>
        Name
        <input name="name" required />
      </label>
      <label>
        Center latitude
        <input name="center_lat" type="number" step="any" required />
      </label>
      <label>
        Center longitude
        <input name="center_lng" type="number" step="any" required />
      </label>
      <label>
        Radius (meters, optional)
        <input name="radius_m" type="number" step="any" min="1" />
      </label>
      <label>
        Center label (optional)
        <input name="center_label" />
      </label>
      <button type="submit">Create Locale</button>
    </form>
    <p id="error" hidden></p>
    <script>
      const form = document.getElementById('locale-form');
      const errorEl = document.getElementById('error');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        const fd = new FormData(form);
        const radiusRaw = String(fd.get('radius_m') ?? '').trim();
        const body = {
          name: String(fd.get('name') ?? ''),
          center_lat: Number(fd.get('center_lat')),
          center_lng: Number(fd.get('center_lng')),
          center_label: String(fd.get('center_label') ?? '').trim() || null,
          ...(radiusRaw ? { radius_m: Number(radiusRaw) } : {}),
        };
        const res = await fetch('/api/locales/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) {
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = data.error ?? 'Create failed';
          }
          return;
        }
        window.location.href = `/app/locales/${data.id}`;
      });
    </script>
  </body>
</html>
