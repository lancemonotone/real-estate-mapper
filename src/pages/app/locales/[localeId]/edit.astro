---
import AppLayout from '../../../../layouts/AppLayout.astro';
import '../../../../styles/locale-map.css';
import {
  LOCALE_RADIUS_MILES_OPTIONS,
  nearestAllowedRadiusMiles,
  milesToMeters,
} from '../../../../lib/geo/locale-radius';
import { getLocaleForNestMember, localeNeedsSetup } from '../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const selectedMiles = nearestAllowedRadiusMiles(locale.radius_m);
const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);
---
<AppLayout
  title={`Edit ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { label: 'Edit' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="edit"
>
  <h1>Edit Locale</h1>
  {
    localeNeedsSetup(locale) && (
      <p class="alert" role="alert">
        Set a center place below — coords are currently unset (0,0).
      </p>
    )
  }
  <form id="locale-form" class="stack">
    <label>
      Name
      <input name="name" id="locale-name" required value={locale.name} />
    </label>
    <label>
      Center place
      <input
        name="place"
        id="locale-place"
        placeholder="City, neighborhood, or address"
        value={locale.center_label ?? ''}
      />
    </label>
    <label>
      Radius
      <select name="radius_miles" id="locale-radius" required>
        {
          LOCALE_RADIUS_MILES_OPTIONS.map((m) => (
            <option value={m} selected={m === selectedMiles}>
              {m} miles
            </option>
          ))
        }
      </select>
    </label>
    <button type="submit">Save</button>
  </form>
  <div
    id="locale-map"
    class="locale-map map-well"
    data-key={browserKey}
    data-map-id={mapId}
    data-lat={hasCenter ? String(locale.center_lat) : ''}
    data-lng={hasCenter ? String(locale.center_lng) : ''}
    data-radius-m={String(milesToMeters(selectedMiles))}
    data-title={locale.name}
  ></div>
  <p id="map-hint" class="locale-map-missing muted">
    {locale.center_label ?? (hasCenter ? '' : 'Enter a place name to preview the map.')}
  </p>
  <p id="error" class="alert" hidden></p>
  <script
    define:vars={{
      localeId: locale.id,
      base,
      initialHasCenter: hasCenter,
    }}
  >
    window.__WAYHOME_LOCALE_FORM__ = {
      mode: 'edit',
      localeId,
      base,
      initialHasCenter,
    };
  </script>
  <script src="/scripts/locale-map.js" type="module"></script>
  <script src="/scripts/locale-form.js" type="module"></script>
</AppLayout>
