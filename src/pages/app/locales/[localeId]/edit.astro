---
import AppLayout from '../../../../layouts/AppLayout.astro';
import LocaleListingPrefsFields from '../../../../components/LocaleListingPrefsFields.astro';
import '../../../../styles/locale-map.css';
import {
  LOCALE_RADIUS_MILES_OPTIONS,
  nearestAllowedRadiusMiles,
  milesToMeters,
} from '../../../../lib/geo/locale-radius';
import { getVisibleLocaleContext, localeNeedsSetup } from '../../../../lib/supabase/nest';
import { loadNestEntitlementUi } from '../../../../lib/nest/entitlements/ui-context';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;
const localeContext = localeId
  ? await getVisibleLocaleContext(supabase, localeId, Astro.locals.devHuntPassPreview ?? false)
  : null;
if (!localeContext) return new Response('Not found', { status: 404 });

const { locale, snapshot } = localeContext;
const entitlementUi = await loadNestEntitlementUi(
  supabase,
  locale.nest_id,
  user.id,
  Astro.locals.devHuntPassPreview ?? false,
  snapshot,
);

const selectedMiles = nearestAllowedRadiusMiles(locale.radius_m);
const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);
---
<AppLayout
  title={`Edit ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { label: 'Edit' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  nestId={locale.nest_id}
  entitlementUi={entitlementUi}
  localeSection="edit"
>
  <h1>Edit Locale</h1>
  {
    localeNeedsSetup(locale) && (
      <p class="alert" role="alert">
        Set a center place below — coords are currently unset (0,0).
      </p>
    )
  }

  <section class="locale-browse">
    <div class="locale-browse__list stack">
      <div class="nest-tabs locale-form-tabs" data-nest-tabs>
        <nav
          class="locale-nav nest-tabs__bar"
          aria-label="Locale settings"
          data-nest-tabs-bar
          role="tablist"
        >
          <span class="locale-nav__pill" aria-hidden="true" data-nest-tabs-pill></span>
          <button
            type="button"
            class="button secondary locale-nav__link locale-nav__link--active"
            id="locale-tab-general"
            role="tab"
            aria-selected="true"
            aria-controls="locale-panel-general"
            tabindex="0"
            data-nest-tab="general"
          >
            General
          </button>
          <button
            type="button"
            class="button secondary locale-nav__link"
            id="locale-tab-import"
            role="tab"
            aria-selected="false"
            aria-controls="locale-panel-import"
            tabindex="-1"
            data-nest-tab="import"
          >
            Listing import
          </button>
        </nav>

        <form id="locale-form" class="stack locale-form-tabs__form">
          <div
            class="nest-tabs__panel stack"
            id="locale-panel-general"
            role="tabpanel"
            aria-labelledby="locale-tab-general"
            data-nest-tab-panel="general"
          >
            <label>
              Name
              <input name="name" id="locale-name" required value={locale.name} />
            </label>
            <label>
              Center place
              <input
                name="place"
                id="locale-place"
                placeholder="City, neighborhood, or address"
                value={locale.center_label ?? ''}
              />
            </label>
            <label>
              Radius
              <select name="radius_miles" id="locale-radius" required>
                {
                  LOCALE_RADIUS_MILES_OPTIONS.map((m) => (
                    <option value={m} selected={m === selectedMiles}>
                      {m} miles
                    </option>
                  ))
                }
              </select>
            </label>
          </div>

          <div
            class="nest-tabs__panel stack"
            id="locale-panel-import"
            role="tabpanel"
            aria-labelledby="locale-tab-import"
            data-nest-tab-panel="import"
            hidden
          >
            <LocaleListingPrefsFields prefs={locale.listing_prefs} showTitle={false} />
          </div>

          <button type="submit">Save</button>
        </form>
      </div>

      <p id="error" class="alert" hidden></p>

      <section class="locale-form-danger stack">
        <h2 class="locale-form-danger__title">Delete Locale</h2>
        <p class="muted locale-form-danger__copy">
          Permanently removes this Locale and all its listings, tours, and travel data.
        </p>
        <button type="button" class="button danger" id="locale-delete">Delete Locale</button>
      </section>
    </div>

    <div class="locale-browse__map stack">
      <div
        id="locale-map"
        class="locale-map map-well locale-browse__map-well"
        data-key={browserKey}
        data-map-id={mapId}
        data-lat={hasCenter ? String(locale.center_lat) : ''}
        data-lng={hasCenter ? String(locale.center_lng) : ''}
        data-radius-m={String(milesToMeters(selectedMiles))}
        data-title={locale.name}
      ></div>
      <p id="map-hint" class="locale-map-missing muted">
        {locale.center_label ?? (hasCenter ? '' : 'Enter a place name to preview the map.')}
      </p>
    </div>
  </section>

  <script
    define:vars={{
      localeId: locale.id,
      localeName: locale.name,
      base,
      initialHasCenter: hasCenter,
    }}
  >
    window.__WAYHOME_LOCALE_FORM__ = {
      mode: 'edit',
      localeId,
      localeName,
      base,
      initialHasCenter,
    };
  </script>
  <script src="/scripts/locale-map.js" type="module"></script>
  <script src="/scripts/nest-tabs.js" type="module"></script>
  <script src="/scripts/locale-form.js" type="module"></script>
</AppLayout>
