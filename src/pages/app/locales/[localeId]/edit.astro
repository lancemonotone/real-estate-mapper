---
import AppLayout from '../../../../layouts/AppLayout.astro';
import '../../../../styles/locale-map.css';
import {
  LOCALE_RADIUS_MILES_OPTIONS,
  nearestAllowedRadiusMiles,
  milesToMeters,
} from '../../../../lib/geo/locale-radius';
import { getLocaleForNestMember, localeNeedsSetup } from '../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const selectedMiles = nearestAllowedRadiusMiles(locale.radius_m);
const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);
---
<AppLayout
  title={`Edit ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Nest' },
    { href: base, label: locale.name },
    { label: 'Edit' },
  ]}
>
  <h1>Edit Locale</h1>
  {
    localeNeedsSetup(locale) && (
      <p class="alert" role="alert">
        Set a center place below — coords are currently unset (0,0).
      </p>
    )
  }
  <form id="locale-form">
    <label>
      Name
      <input name="name" id="locale-name" required value={locale.name} />
    </label>
    <label>
      Center place
      <input
        name="place"
        id="locale-place"
        placeholder="City, neighborhood, or address"
        value={locale.center_label ?? ''}
      />
    </label>
    <label>
      Radius
      <select name="radius_miles" id="locale-radius" required>
        {
          LOCALE_RADIUS_MILES_OPTIONS.map((m) => (
            <option value={m} selected={m === selectedMiles}>
              {m} miles
            </option>
          ))
        }
      </select>
    </label>
    <button type="submit">Save</button>
  </form>
  <div
    id="locale-map"
    class="locale-map map-well"
    data-key={browserKey}
    data-map-id={mapId}
    data-lat={hasCenter ? String(locale.center_lat) : ''}
    data-lng={hasCenter ? String(locale.center_lng) : ''}
    data-radius-m={String(milesToMeters(selectedMiles))}
    data-title={locale.name}
  ></div>
  <p id="map-hint" class="locale-map-missing muted">
    {locale.center_label ?? (hasCenter ? '' : 'Enter a place name to preview the map.')}
  </p>
  <p id="error" class="alert" hidden></p>
  <script src="/scripts/locale-map.js" type="module"></script>
  <script define:vars={{ localeId: locale.id, base, initialHasCenter: hasCenter }}>
    const form = document.getElementById('locale-form');
    const errorEl = document.getElementById('error');
    const placeEl = document.getElementById('locale-place');
    const radiusEl = document.getElementById('locale-radius');
    const nameEl = document.getElementById('locale-name');
    const mapEl = document.getElementById('locale-map');
    const hintEl = document.getElementById('map-hint');
    let previewTimer = null;
    let lastCenter = initialHasCenter
      ? {
          lat: Number(mapEl?.dataset.lat),
          lng: Number(mapEl?.dataset.lng),
        }
      : null;

    const milesToMeters = (m) => m * 1609.344;

    function pushMapUpdate(detail) {
      mapEl?.dispatchEvent(new CustomEvent('locale-map:update', { detail }));
    }

    async function previewPlace() {
      const place = placeEl instanceof HTMLInputElement ? placeEl.value.trim() : '';
      if (!place) return;
      const res = await fetch('/api/locales/preview-place', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ place }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        if (hintEl) hintEl.textContent = data.error ?? 'Place not found';
        return;
      }
      lastCenter = { lat: data.lat, lng: data.lng };
      const miles =
        radiusEl instanceof HTMLSelectElement ? Number(radiusEl.value) : 10;
      const title =
        nameEl instanceof HTMLInputElement && nameEl.value.trim()
          ? nameEl.value.trim()
          : data.formattedAddress;
      if (hintEl) hintEl.textContent = data.formattedAddress;
      pushMapUpdate({
        lat: data.lat,
        lng: data.lng,
        radiusM: milesToMeters(miles),
        title,
      });
    }

    placeEl?.addEventListener('input', () => {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(() => {
        previewPlace().catch(() => {});
      }, 450);
    });

    radiusEl?.addEventListener('change', () => {
      const miles = Number(radiusEl.value);
      if (!lastCenter) {
        pushMapUpdate({ radiusM: milesToMeters(miles) });
        return;
      }
      pushMapUpdate({
        lat: lastCenter.lat,
        lng: lastCenter.lng,
        radiusM: milesToMeters(miles),
      });
    });

    nameEl?.addEventListener('input', () => {
      const title =
        nameEl instanceof HTMLInputElement && nameEl.value.trim()
          ? nameEl.value.trim()
          : 'Locale';
      pushMapUpdate({ title });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const fd = new FormData(form);
      const place = String(fd.get('place') ?? '').trim();
      const body = {
        id: localeId,
        name: String(fd.get('name') ?? ''),
        radius_miles: Number(fd.get('radius_miles')),
        ...(place ? { place } : {}),
      };
      const res = await fetch('/api/locales/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) {
        if (errorEl) {
          errorEl.hidden = false;
          errorEl.textContent = data.error ?? 'Save failed';
        }
        return;
      }
      window.location.href = base;
    });
  </script>
</AppLayout>
