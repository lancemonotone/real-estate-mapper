---
import AppLayout from '../../../../layouts/AppLayout.astro';
import DirectionsOverlay from '../../../../components/DirectionsOverlay.astro';
import { PLACE_TYPE_CATALOG } from '../../../../lib/proximity/place-types';
import { getLocaleForNestMember } from '../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';

const { data: listings } = await supabase
  .from('listings')
  .select('id, name, address, lat, lng, photo_url')
  .eq('locale_id', locale.id)
  .order('created_at', { ascending: false });

const { data: criteria } = await supabase
  .from('proximity_criteria')
  .select('*')
  .eq('locale_id', locale.id)
  .order('sort_order', { ascending: true })
  .order('created_at', { ascending: true });

const listingIds = (listings ?? []).map((l) => l.id);
const { data: results } =
  listingIds.length > 0
    ? await supabase
        .from('proximity_results')
        .select('*')
        .in('listing_id', listingIds)
    : { data: [] as never[] };

const resultMap = new Map<string, (typeof results)[number]>();
for (const row of results ?? []) {
  resultMap.set(`${row.listing_id}:${row.criterion_id}`, row);
}

const placeTypes = Object.entries(PLACE_TYPE_CATALOG).map(([key, v]) => ({
  key,
  label: v.label,
}));

const listingRows = listings ?? [];
const criterionRows = criteria ?? [];
---
<AppLayout
  title={`Travel Times — ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { label: 'Travel Times' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="travel"
>
  <header class="compare-header">
    <div class="compare-header__titles">
      <h1 class="compare-header__title">Travel Times</h1>
      <p class="muted compare-header__sub">
        Drive, walk, bike, or transit times from each listing to shared destinations.
      </p>
    </div>
    <button type="button" class="button compare-header__add" data-compare-column-open>
      Add column
    </button>
  </header>

  {
    listingRows.length === 0 ? (
      <p class="muted">No listings in this Locale yet.</p>
    ) : (
      <>
        {criterionRows.length === 0 ? (
          <p class="muted compare-empty-hint">
            No travel columns yet.{' '}
            <button type="button" class="linkish" data-compare-column-open>
              Add a column
            </button>{' '}
            to start comparing times.
          </p>
        ) : null}
        <div class="matrix-scroll">
          <table class="data matrix-table" id="compare-table">
            <thead>
              <tr>
                <th class="matrix-table__listing">Listing</th>
                {criterionRows.map((c) => (
                  <th
                    data-criterion-id={c.id}
                    data-place-type-key={c.kind === 'place_type' ? c.place_type_key ?? '' : ''}
                    data-travel-mode={c.travel_mode}
                  >
                    <div class="matrix-criterion-head">
                      <span class="matrix-criterion-head__label">{c.label}</span>
                      <button
                        type="button"
                        class="secondary icon-btn delete-criterion"
                        data-criterion-id={c.id}
                        aria-label={`Delete ${c.label}`}
                        title={`Delete ${c.label}`}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                          <path d="M6 6l12 12"></path>
                          <path d="M18 6L6 18"></path>
                        </svg>
                      </button>
                    </div>
                    <small class="muted">
                      {c.kind === 'place_type' ? `Nearest · ${c.place_type_key}` : 'Shared place'} ·{' '}
                      {c.travel_mode}
                    </small>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {listingRows.map((listing) => {
                const title = listing.name || listing.address || listing.id;
                const photo = listing.photo_url;
                return (
                  <tr>
                    <th scope="row" class="matrix-table__listing">
                      <a class="matrix-listing" href={`${base}/listings/${listing.id}`}>
                        <span class="matrix-listing__media">
                          {photo ? (
                            <img class="matrix-listing__thumb" src={photo} alt="" loading="lazy" />
                          ) : (
                            <span class="matrix-listing__thumb matrix-listing__thumb--empty" aria-hidden="true">
                              No photo
                            </span>
                          )}
                        </span>
                        <span class="matrix-listing__text">
                          <span class="matrix-listing__name">{title}</span>
                          {listing.address && listing.name ? (
                            <span class="muted matrix-listing__address">{listing.address}</span>
                          ) : null}
                        </span>
                      </a>
                    </th>
                    {criterionRows.map((c) => {
                      const row = resultMap.get(`${listing.id}:${c.id}`);
                      return (
                        <td
                          data-listing-id={listing.id}
                          data-criterion-id={c.id}
                          data-listing-lat={listing.lat != null ? String(listing.lat) : ''}
                          data-listing-lng={listing.lng != null ? String(listing.lng) : ''}
                          data-travel-mode={c.travel_mode}
                          data-status={row?.status ?? ''}
                        >
                          {row ? (
                            <span class="seeded" data-seeded="1" hidden>
                              {JSON.stringify(row)}
                            </span>
                          ) : null}
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <div
    id="compare-column-overlay"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="compare-column-title"
  >
    <div class="compare-column-overlay__backdrop" data-compare-column-close></div>
    <div class="compare-column-overlay__panel glass glass--strong">
      <header class="compare-column-overlay__header">
        <h2 id="compare-column-title">Add travel column</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-compare-column-close
          aria-label="Close"
          title="Close"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
          </svg>
        </button>
      </header>
      <form id="criterion-form" class="criterion-form stack">
        <input type="hidden" name="locale_id" value={locale.id} />
        <label>
          Label
          <input type="text" name="label" required placeholder="e.g. Beach drive" />
        </label>
        <label>
          Kind
          <select name="kind" id="criterion-kind">
            <option value="place_type">Nearest place type</option>
            <option value="fixed_pin">Shared place</option>
          </select>
        </label>
        <label id="type-fields">
          Place type
          <select name="place_type_key">
            {placeTypes.map((t) => (
              <option value={t.key}>{t.label}</option>
            ))}
          </select>
        </label>
        <div id="pin-fields" class="pin-fields stack" hidden>
          <div class="place-search" id="compare-place-search">
            <label>
              Place or address
              <input type="search" data-place-search-input placeholder="Start typing…" autocomplete="off" />
            </label>
            <ul class="place-search__results stack" data-place-search-results hidden></ul>
            <p class="alert" data-place-search-error hidden></p>
          </div>
        </div>
        <label>
          Travel mode
          <select name="travel_mode">
            <option value="DRIVE">Drive</option>
            <option value="WALK">Walk</option>
            <option value="BICYCLE">Bicycle</option>
            <option value="TRANSIT">Transit</option>
          </select>
        </label>
        <button type="submit">Add column</button>
      </form>
      <p id="criterion-status" class="muted"></p>
    </div>
  </div>

  <!-- Change cell location (same flow as listing Travel Times edit) -->
  <div
    id="compare-place-overlay"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="compare-place-overlay-title"
  >
    <div class="compare-column-overlay__backdrop" data-compare-place-close></div>
    <div
      class="compare-column-overlay__panel glass glass--strong listing-overlay__panel listing-overlay__panel--place"
    >
      <header class="compare-column-overlay__header">
        <h2 id="compare-place-overlay-title">Change location</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-compare-place-close
          aria-label="Close"
          title="Close"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
          </svg>
        </button>
      </header>
      <div class="place-picker">
        <div class="place-picker__form proximity-panel stack">
          <p class="muted prox-lede" id="compare-prox-lede">
            Find a nearby type or search a place, then save.
          </p>
          <div class="prox-fields stack">
            <label>
              Mode
              <select id="compare-prox-mode-kind">
                <option value="nearest">Nearest type</option>
                <option value="search">Search place</option>
              </select>
            </label>
            <div id="compare-prox-nearest-fields" class="stack">
              <label>
                Place type
                <select id="compare-prox-place-type">
                  {placeTypes.map((t) => (
                    <option value={t.key}>{t.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <div id="compare-prox-search-fields" class="stack" hidden>
              <div class="place-search" id="compare-prox-place-search">
                <label>
                  Place or address
                  <input
                    type="search"
                    data-place-search-input
                    placeholder="Start typing…"
                    autocomplete="off"
                  />
                </label>
                <ul class="place-search__results stack" data-place-search-results hidden></ul>
                <p class="alert" data-place-search-error hidden></p>
              </div>
            </div>
            <label>
              Travel mode
              <select id="compare-prox-mode">
                <option value="DRIVE">Drive</option>
                <option value="WALK">Walk</option>
                <option value="BICYCLE">Bicycle</option>
                <option value="TRANSIT">Transit</option>
              </select>
            </label>
          </div>
          <div class="prox-actions">
            <button type="button" id="compare-prox-run" title="Find nearby places and drive times">
              Find route
            </button>
            <button
              type="button"
              id="compare-prox-save"
              class="secondary"
              hidden
              title="Save this location"
            >
              Save
            </button>
          </div>
          <div id="compare-prox-choices" class="prox-choices stack" hidden></div>
          <div id="compare-prox-result" class="prox-result" hidden></div>
        </div>
        <div class="place-picker__map-col">
          <div id="compare-prox-picker-map" class="place-picker__map map-well"></div>
          <p id="compare-prox-picker-map-meta" class="place-picker__map-meta muted" hidden></p>
          <a
            id="compare-prox-picker-maps-link"
            class="secondary icon-btn place-picker__maps-link"
            href="#"
            target="_blank"
            rel="noopener"
            hidden
            aria-label="Open in Google Maps"
            title="Open in Google Maps"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z"></path>
              <path d="M12 11.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script
    define:vars={{
      localeId: locale.id,
      mapKey: browserKey,
      mapId,
    }}
  >
    window.__WAYHOME_LOCALE_ID__ = localeId;
    window.__WAYHOME_MAPS__ = { mapKey, mapId };
    window.__WAYHOME_COMPARE__ = { localeId, mapKey, mapId };
  </script>
  <DirectionsOverlay />
  <script src="/scripts/directions-overlay.js" type="module"></script>
  <script src="/scripts/proximity-compare.js" type="module"></script>
</AppLayout>
