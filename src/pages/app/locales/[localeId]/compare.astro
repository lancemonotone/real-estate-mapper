---
import AppLayout from '../../../../layouts/AppLayout.astro';
import FavoriteFilterButton from '../../../../components/FavoriteFilterButton.astro';
import ListingReactions from '../../../../components/ListingReactions.astro';
import { filterVisibleListings, loadNestEntitlementUi } from '../../../../lib/nest/entitlements';
import { getVisibleLocaleContext } from '../../../../lib/supabase/nest';
import { LISTING_FIELD_LABELS } from '../../../../lib/listings/field-labels';
import {
  formatAmenities,
  formatListingMonthlyTotal,
  formatMoney,
  formatNumber,
  formatSqft,
  sumListingMonthlyTotal,
  sumListingMoveInTotal,
} from '../../../../lib/listings/format-attributes';
import {
  compareByDollarsPerSqftAsc,
  dollarsPerSqft,
  formatDollarsPerSqft,
} from '../../../../lib/listings/value-rank';
import type { Listing } from '../../../../lib/types/database';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;
const localeContext = localeId
  ? await getVisibleLocaleContext(supabase, localeId, Astro.locals.devHuntPassPreview ?? false)
  : null;
if (!localeContext) return new Response('Not found', { status: 404 });

const { locale, snapshot } = localeContext;
const entitlementUi = await loadNestEntitlementUi(
  supabase,
  locale.nest_id,
  user.id,
  Astro.locals.devHuntPassPreview ?? false,
  snapshot,
);
const showListingGallery = snapshot.plan !== 'free';

const base = `/app/locales/${locale.id}`;

const { data: listings } = await supabase
  .from('listings')
  .select(
    'id, name, address, phone, photo_url, photo_urls, price_monthly, deposit, fees_monthly, application_fees, move_in_fees, sqft, beds, baths, pet_rent_monthly, pet_deposit, amenities, is_favorite, is_passed',
  )
  .eq('locale_id', locale.id)
  .order('created_at', { ascending: false });

const rowsUnsorted = filterVisibleListings(listings ?? [], snapshot) as Pick<
  Listing,
  | 'id'
  | 'name'
  | 'address'
  | 'phone'
  | 'photo_url'
  | 'photo_urls'
  | 'price_monthly'
  | 'deposit'
  | 'fees_monthly'
  | 'application_fees'
  | 'move_in_fees'
  | 'sqft'
  | 'beds'
  | 'baths'
  | 'pet_rent_monthly'
  | 'pet_deposit'
  | 'amenities'
  | 'is_favorite'
  | 'is_passed'
>[];

type Row = (typeof rowsUnsorted)[number];

const rows = [...rowsUnsorted].sort((a, b) =>
  compareByDollarsPerSqftAsc(
    { dpsf: dollarsPerSqft(sumListingMonthlyTotal(a), a.sqft) },
    { dpsf: dollarsPerSqft(sumListingMonthlyTotal(b), b.sqft) },
  ),
);

const incompleteValueCount = rows.filter(
  (l) => dollarsPerSqft(sumListingMonthlyTotal(l), l.sqft) == null,
).length;

const columns: {
  label: string;
  sortType: 'text' | 'number';
  sortValue: (l: Row) => string;
  cell: (l: Row) => string;
  wide?: boolean;
  defaultSort?: 'ascending' | 'descending';
}[] = [
  {
    label: LISTING_FIELD_LABELS.dollarsPerSqft,
    sortType: 'number',
    sortValue: (l) => {
      const dpsf = dollarsPerSqft(sumListingMonthlyTotal(l), l.sqft);
      return dpsf == null ? '' : String(dpsf);
    },
    cell: (l) => formatDollarsPerSqft(dollarsPerSqft(sumListingMonthlyTotal(l), l.sqft)),
    defaultSort: 'ascending',
  },
  {
    label: LISTING_FIELD_LABELS.totalMonthly,
    sortType: 'number',
    sortValue: (l) => {
      const total = sumListingMonthlyTotal(l);
      return total == null ? '' : String(total);
    },
    cell: (l) => formatListingMonthlyTotal(l),
  },
  {
    label: LISTING_FIELD_LABELS.sqft,
    sortType: 'number',
    sortValue: (l) => (l.sqft == null ? '' : String(l.sqft)),
    cell: (l) => formatSqft(l.sqft),
  },
  {
    label: LISTING_FIELD_LABELS.totalMoveIn,
    sortType: 'number',
    sortValue: (l) => {
      const total = sumListingMoveInTotal(l);
      return total == null ? '' : String(total);
    },
    cell: (l) => formatMoney(sumListingMoveInTotal(l)),
  },
  {
    label: LISTING_FIELD_LABELS.deposit,
    sortType: 'number',
    sortValue: (l) => (l.deposit == null ? '' : String(l.deposit)),
    cell: (l) => formatMoney(l.deposit),
  },
  {
    label: LISTING_FIELD_LABELS.petDeposit,
    sortType: 'number',
    sortValue: (l) => (l.pet_deposit == null ? '' : String(l.pet_deposit)),
    cell: (l) => formatMoney(l.pet_deposit),
  },
  {
    label: LISTING_FIELD_LABELS.applicationFees,
    sortType: 'number',
    sortValue: (l) => (l.application_fees == null ? '' : String(l.application_fees)),
    cell: (l) => formatMoney(l.application_fees),
  },
  {
    label: LISTING_FIELD_LABELS.moveInFees,
    sortType: 'number',
    sortValue: (l) => (l.move_in_fees == null ? '' : String(l.move_in_fees)),
    cell: (l) => formatMoney(l.move_in_fees),
  },
  {
    label: LISTING_FIELD_LABELS.rentMonthly,
    sortType: 'number',
    sortValue: (l) => (l.price_monthly == null ? '' : String(l.price_monthly)),
    cell: (l) => formatMoney(l.price_monthly),
  },
  {
    label: LISTING_FIELD_LABELS.feesMonthly,
    sortType: 'number',
    sortValue: (l) => (l.fees_monthly == null ? '' : String(l.fees_monthly)),
    cell: (l) => formatMoney(l.fees_monthly),
  },
  {
    label: LISTING_FIELD_LABELS.petMonthly,
    sortType: 'number',
    sortValue: (l) => (l.pet_rent_monthly == null ? '' : String(l.pet_rent_monthly)),
    cell: (l) => formatMoney(l.pet_rent_monthly),
  },
  {
    label: LISTING_FIELD_LABELS.beds,
    sortType: 'number',
    sortValue: (l) => (l.beds == null ? '' : String(l.beds)),
    cell: (l) => formatNumber(l.beds),
  },
  {
    label: LISTING_FIELD_LABELS.baths,
    sortType: 'number',
    sortValue: (l) => (l.baths == null ? '' : String(l.baths)),
    cell: (l) => formatNumber(l.baths),
  },
  {
    label: LISTING_FIELD_LABELS.amenities,
    sortType: 'text',
    sortValue: (l) => (l.amenities ?? []).join(', '),
    cell: (l) => formatAmenities(l.amenities),
    wide: true,
  },
];
---
<AppLayout
  title={`Compare — ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { label: 'Compare' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="compare"
  nestId={locale.nest_id}
  entitlementUi={entitlementUi}
>
  <div class="matrix-panel">
    <div class="matrix-panel__header">
      <div class="compare-header__top">
        <div class="matrix-panel__titles compare-header__titles">
          <h1 class="compare-header__title">Compare</h1>
        </div>
        <div class="matrix-panel__actions compare-header__actions">
          <FavoriteFilterButton />
        </div>
      </div>
      <p class="muted compare-header__sub">
        Value is Total/mo ÷ sq ft (lower is better). Sorted by Value when both are set. Click a
        column header to re-sort. Move-in includes deposit and one-time fees when entered.
        {rows.length > 0 && incompleteValueCount > 0
          ? ` ${incompleteValueCount} listing${incompleteValueCount === 1 ? '' : 's'} missing Total/mo or sq ft sort last.`
          : ''}
      </p>
    </div>
    {
      rows.length === 0 ? (
        <p class="muted">No listings in this Locale yet.</p>
      ) : (
        <>
          <p class="muted compare-empty-hint" data-favorites-empty hidden>
            No favorited listings. Heart a listing or turn off the favorites filter.
          </p>
          <div class="matrix-scroll">
        <table
          class="data matrix-table matrix-table--wrap"
          data-sortable
          style={`--data-cols: ${columns.length}`}
        >
          <thead>
            <tr>
              <th class="matrix-table__listing" data-sort-type="text">
                <button type="button" class="matrix-sort">
                  Listing
                </button>
              </th>
              {columns.map((col) => (
                <th
                  class:list={[col.wide ? 'matrix-table__wide' : 'matrix-table__compact']}
                  data-sort-type={col.sortType}
                  aria-sort={col.defaultSort}
                >
                  <button type="button" class="matrix-sort">
                    {col.label}
                  </button>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((listing) => {
              const title = listing.name || listing.address || listing.id;
              const photo = listing.photo_url;
              return (
                <tr
                  data-listing-id={listing.id}
                  data-favorite={listing.is_favorite ? '1' : '0'}
                  data-passed={listing.is_passed ? '1' : '0'}
                >
                  <th
                    scope="row"
                    class="matrix-table__listing"
                    data-sort-value={title}
                  >
                    <div class="matrix-listing">
                      {photo ? (
                        showListingGallery ? (
                          <button
                            type="button"
                            class="matrix-listing__media"
                            data-listing-gallery
                            data-photo-urls={JSON.stringify(
                              listing.photo_urls?.length
                                ? listing.photo_urls
                                : [photo],
                            )}
                            data-photo-index="0"
                            aria-label={`Photos: ${title}`}
                          >
                            <img class="matrix-listing__thumb" src={photo} alt="" loading="lazy" />
                          </button>
                        ) : (
                          <span class="matrix-listing__media">
                            <img class="matrix-listing__thumb" src={photo} alt="" loading="lazy" />
                          </span>
                        )
                      ) : (
                        <span class="matrix-listing__thumb matrix-listing__thumb--empty" aria-hidden="true">
                          No photo
                        </span>
                      )}
                      <a class="matrix-listing__text" href={`${base}/listings/${listing.id}`}>
                        <span class="matrix-listing__name">{title}</span>
                        {listing.address && listing.name ? (
                          <span class="muted matrix-listing__address">{listing.address}</span>
                        ) : null}
                        {listing.phone ? (
                          <span class="muted matrix-listing__phone">{listing.phone}</span>
                        ) : null}
                      </a>
                      <ListingReactions
                        listingId={listing.id}
                        favorited={Boolean(listing.is_favorite)}
                        passed={Boolean(listing.is_passed)}
                      />
                    </div>
                  </th>
                  {columns.map((col) => (
                    <td
                      class:list={[col.wide ? 'matrix-table__wide' : 'matrix-table__compact']}
                      data-sort-value={col.sortValue(listing)}
                    >
                      {col.wide ? (
                        <div class="matrix-amenities-cell">{col.cell(listing)}</div>
                      ) : (
                        <span class="matrix-data-cell">{col.cell(listing)}</span>
                      )}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
          </div>
        </>
      )
    }
  </div>

  <script src="/scripts/matrix-sort.js" type="module"></script>
</AppLayout>
