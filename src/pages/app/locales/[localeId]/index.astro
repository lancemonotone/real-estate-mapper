---
import '../../../../styles/locale-map.css';
import {
  nearestAllowedRadiusMiles,
  milesToMeters,
} from '../../../../lib/geo/locale-radius';
import { getLocaleForNestMember, localeNeedsSetup } from '../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const radiusMiles = nearestAllowedRadiusMiles(locale.radius_m);
const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{locale.name} — Wayhome</title>
  </head>
  <body>
    <header>
      <p><a href="/app">← Nest</a></p>
      <h1>{locale.name}</h1>
      {
        locale.center_label && (
          <p>
            Center: {locale.center_label} · {radiusMiles} mi radius
          </p>
        )
      }
      {
        !locale.center_label && hasCenter && (
          <p>
            Center: {locale.center_lat.toFixed(4)}, {locale.center_lng.toFixed(4)} · {radiusMiles} mi
            radius
          </p>
        )
      }
      {
        localeNeedsSetup(locale) && (
          <p role="alert">
            This Locale needs a real center. <a href={`${base}/edit`}>Edit Locale</a> and search a
            place name.
          </p>
        )
      }
      <p><a href={`${base}/edit`}>Edit Locale</a></p>
      {
        hasCenter ? (
          <div
            id="locale-map"
            class="locale-map"
            data-key={browserKey}
            data-map-id={mapId}
            data-lat={String(locale.center_lat)}
            data-lng={String(locale.center_lng)}
            data-radius-m={String(milesToMeters(radiusMiles))}
            data-title={locale.name}
          ></div>
        ) : (
          <p class="locale-map-missing">No map until a center place is set.</p>
        )
      }
      <nav>
        <a href={`${base}/listings`}>Listings</a>
        <a href={`${base}/unscheduled`}>Unscheduled</a>
        <a href={`${base}/tours`}>Tours</a>
      </nav>
    </header>
    {hasCenter && <script src="/scripts/locale-map.js" type="module"></script>}
  </body>
</html>
