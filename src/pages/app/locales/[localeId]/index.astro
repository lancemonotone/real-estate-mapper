---
import AppLayout from '../../../../layouts/AppLayout.astro';
import FavoriteFilterButton from '../../../../components/FavoriteFilterButton.astro';
import ListingReactions from '../../../../components/ListingReactions.astro';
import ListingForm from '../../../../components/ListingForm.astro';
import PlanNotice from '../../../../components/PlanNotice.astro';
import '../../../../styles/locale-map.css';
import {
  metersToMiles,
  milesToMeters,
  nearestAllowedRadiusMiles,
} from '../../../../lib/geo/locale-radius';
import { haversineMeters } from '../../../../lib/geo/haversine';
import {
  filterVisibleListings,
  isListingCapReached,
  loadNestEntitlementUi,
  PLAN_LIMITS,
  PLAN_MESSAGES,
} from '../../../../lib/nest/entitlements';
import { getVisibleLocaleContext, localeNeedsSetup } from '../../../../lib/supabase/nest';
import { formatMoney, formatSqft, formatListingMonthlyTotal, sumListingMonthlyTotal } from '../../../../lib/listings/format-attributes';
import { LISTING_FIELD_LABELS } from '../../../../lib/listings/field-labels';
import IconGlyph from '../../../../components/IconGlyph.astro';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;
const localeContext = localeId
  ? await getVisibleLocaleContext(supabase, localeId, Astro.locals.devHuntPassPreview ?? false)
  : null;
if (!localeContext) return new Response('Not found', { status: 404 });

const { locale, snapshot } = localeContext;
const entitlementUi = await loadNestEntitlementUi(
  supabase,
  locale.nest_id,
  user.id,
  Astro.locals.devHuntPassPreview ?? false,
  snapshot,
);
const listingCapReached = isListingCapReached(snapshot);
const listingCapMessage = PLAN_MESSAGES.listingCap(snapshot.plan);
const photoStoredCap =
  snapshot.plan === 'free' ? PLAN_LIMITS.free.photosStoredPerListing : undefined;
const showListingGallery = snapshot.plan !== 'free';

const radiusMiles = nearestAllowedRadiusMiles(locale.radius_m);
const base = `/app/locales/${locale.id}`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);

const centerLine = locale.center_label
  ? `${locale.center_label} · ${radiusMiles} mi radius`
  : hasCenter
    ? `${locale.center_lat.toFixed(4)}, ${locale.center_lng.toFixed(4)} · ${radiusMiles} mi radius`
    : null;

const { data: listings } = await supabase
  .from('listings')
  .select('*')
  .eq('locale_id', locale.id)
  .order('created_at', { ascending: false });

const rows = filterVisibleListings(listings ?? [], snapshot).map((listing) => {
  const distanceM =
    hasCenter && listing.lat != null && listing.lng != null
      ? haversineMeters(
          { lat: locale.center_lat, lng: locale.center_lng },
          { lat: listing.lat, lng: listing.lng },
        )
      : null;
  return { listing, distanceM };
});

const mapListings = rows
  .filter(({ listing }) => listing.lat != null && listing.lng != null)
  .map(({ listing }) => ({
    id: listing.id,
    name: listing.name || listing.address || 'Listing',
    address: listing.address || '',
    lat: listing.lat as number,
    lng: listing.lng as number,
    photoUrl: listing.photo_url,
    favorite: Boolean(listing.is_favorite),
  }));
---
<AppLayout
  title={locale.name}
  crumbs={[{ href: '/app', label: 'Home' }, { label: locale.name }]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="listings"
  nestId={locale.nest_id}
  entitlementUi={entitlementUi}
>
  {
    localeNeedsSetup(locale) && (
      <p class="alert" role="alert">
        This Locale needs a real center. Use the edit button to search a place name.
      </p>
    )
  }

  <section class="locale-browse">
    <div class="locale-browse__list">
      <div class="matrix-panel">
        <div class="matrix-panel__header">
          <div class="compare-header__top">
            <div class="matrix-panel__titles compare-header__titles">
              <div class="locale-hero__heading">
                <h1 class="compare-header__title locale-hero__name">{locale.name}</h1>
                <a
                  class="secondary icon-btn locale-hero__edit"
                  href={`${base}/edit`}
                  title="Edit Locale name, center, and radius"
                  aria-label="Edit Locale name, center, and radius"
                >
                  <IconGlyph name="pencilLine" />
                </a>
                <p class="muted locale-hero__count">
                  {rows.length === 1 ? '1 listing' : `${rows.length} listings`}
                </p>
              </div>
            </div>
            <div class="matrix-panel__actions compare-header__actions">
              {
                rows.length > 0 ? (
                  <label class="listings-sort">
                    <span class="visually-hidden">Sort by</span>
                    <select id="listings-sort" data-listings-sort>
                      <option value="recent">Newest</option>
                      <option value="distance">Distance</option>
                      <option value="price">Lowest price</option>
                    </select>
                  </label>
                ) : null
              }
              <button
                type="button"
                class="button icon-btn compare-header__add"
                data-listing-overlay-open="new"
                aria-label="Add listing"
                title="Add listing"
                disabled={listingCapReached}
              >
                <IconGlyph name="plus" />
              </button>
              <FavoriteFilterButton />
            </div>
          </div>
          {centerLine && <p class="muted compare-header__sub">{centerLine}</p>}
          {
            listingCapReached && entitlementUi && (
              <PlanNotice
                variant="inline"
                isOwner={entitlementUi.isOwner}
                ownerDisplayName={entitlementUi.ownerDisplayName}
              >
                <p class="plan-notice__text">{listingCapMessage}</p>
              </PlanNotice>
            )
          }
        </div>
        {
          rows.length === 0 ? (
            <div class="listings-empty stack">
              <p class="muted">No listings in this Locale yet.</p>
              {
                !listingCapReached ? (
                  <button type="button" class="button" data-listing-overlay-open="new">
                    Add your first listing
                  </button>
                ) : null
              }
            </div>
          ) : (
            <>
              <p class="muted compare-empty-hint" data-favorites-empty hidden>
                No favorited listings. Heart a listing or turn off the favorites filter.
              </p>
              <div class="matrix-scroll">
            <table
              class="data matrix-table matrix-table--listings"
              id="listings-table"
              style="--data-cols: 3"
            >
              <thead>
                <tr>
                  <th class="matrix-table__listing">
                    <span class="matrix-table__heading matrix-head-cell matrix-head-cell--start">Listing</span>
                  </th>
                  <th><span class="matrix-table__heading matrix-head-cell">Distance</span></th>
                  <th><span class="matrix-table__heading matrix-head-cell">{LISTING_FIELD_LABELS.sqft}</span></th>
                  <th><span class="matrix-table__heading matrix-head-cell">{LISTING_FIELD_LABELS.totalMonthly}</span></th>
                </tr>
              </thead>
              <tbody id="listings-list" data-listings-list>
                {rows.map(({ listing, distanceM }) => {
                  const title = listing.name || listing.address || 'Untitled';
                  const photo = listing.photo_url;
                  const created = listing.created_at ? Date.parse(listing.created_at) : 0;
                  const monthlyTotal = sumListingMonthlyTotal(listing);
                  const distanceLabel =
                    distanceM != null
                      ? `${metersToMiles(distanceM).toFixed(1)} mi`
                      : '—';
                  return (
                    <tr
                      data-listing-id={listing.id}
                      data-map-listing={listing.id}
                      data-favorite={listing.is_favorite ? '1' : '0'}
                      data-passed={listing.is_passed ? '1' : '0'}
                      data-sort-recent={String(Number.isFinite(created) ? created : 0)}
                      data-sort-distance={distanceM != null ? String(distanceM) : ''}
                      data-sort-sqft={listing.sqft != null ? String(listing.sqft) : ''}
                      data-sort-price={monthlyTotal != null ? String(monthlyTotal) : ''}
                    >
                      <th scope="row" class="matrix-table__listing">
                        <div class="matrix-listing">
                          {photo ? (
                            showListingGallery ? (
                              <button
                                type="button"
                                class="matrix-listing__media"
                                data-listing-gallery
                                data-photo-urls={JSON.stringify(
                                  listing.photo_urls?.length
                                    ? listing.photo_urls
                                    : [photo],
                                )}
                                data-photo-index="0"
                                aria-label={`Photos: ${title}`}
                              >
                                <img
                                  class="matrix-listing__thumb"
                                  src={photo}
                                  alt=""
                                  loading="lazy"
                                />
                              </button>
                            ) : (
                              <span class="matrix-listing__media">
                                <img
                                  class="matrix-listing__thumb"
                                  src={photo}
                                  alt=""
                                  loading="lazy"
                                />
                              </span>
                            )
                          ) : (
                            <span
                              class="matrix-listing__thumb matrix-listing__thumb--empty"
                              aria-hidden="true"
                            >
                              No photo
                            </span>
                          )}
                          <a class="matrix-listing__text" href={`${base}/listings/${listing.id}`}>
                            <span class="matrix-listing__name">{title}</span>
                            {listing.address && listing.name ? (
                              <span class="muted matrix-listing__address">{listing.address}</span>
                            ) : null}
                            {listing.phone ? (
                              <span class="muted matrix-listing__phone">{listing.phone}</span>
                            ) : null}
                          </a>
                          <ListingReactions
                            listingId={listing.id}
                            favorited={Boolean(listing.is_favorite)}
                            passed={Boolean(listing.is_passed)}
                          />
                        </div>
                      </th>
                      <td><span class="matrix-data-cell">{distanceLabel}</span></td>
                      <td><span class="matrix-data-cell">{formatSqft(listing.sqft)}</span></td>
                      <td><span class="matrix-data-cell">{formatListingMonthlyTotal(listing)}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
              </div>
            </>
          )
        }
      </div>
    </div>

    <div class="locale-browse__map">
      {
        hasCenter ? (
          <div
            id="locale-map"
            class="locale-map map-well locale-browse__map-well"
            data-key={browserKey}
            data-map-id={mapId}
            data-lat={String(locale.center_lat)}
            data-lng={String(locale.center_lng)}
            data-radius-m={String(milesToMeters(radiusMiles))}
            data-title={locale.name}
            data-listings={JSON.stringify(mapListings)}
          ></div>
        ) : (
          <p class="muted">No map until a center place is set.</p>
        )
      }
    </div>
  </section>

  <div
    id="listing-overlay-new"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="listing-overlay-new-title"
    data-listing-overlay="new"
  >
    <div class="compare-column-overlay__backdrop" data-listing-overlay-close></div>
    <div class="compare-column-overlay__panel glass listing-overlay__panel">
      <header class="compare-column-overlay__header">
        <h2 id="listing-overlay-new-title">New listing</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-listing-overlay-close
          aria-label="Close"
          title="Close"
        >
          <IconGlyph name="x" />
        </button>
      </header>
      <div class="listing-overlay__body stack">
        {
          listingCapReached && entitlementUi ? (
            <PlanNotice
              variant="inline"
              isOwner={entitlementUi.isOwner}
              ownerDisplayName={entitlementUi.ownerDisplayName}
            >
              <p class="plan-notice__text">{listingCapMessage}</p>
            </PlanNotice>
          ) : (
            <>
              <section class="listing-form__section listing-import-block">
                <h3 class="listing-import-block__title">Import from URL</h3>
                <form id="import-form" class="listing-import stack">
                  <label class="listing-import__label" for="import-url">Listing URL</label>
                  <div class="listing-import__row">
                    <input
                      type="url"
                      name="url"
                      id="import-url"
                      class="listing-import__input"
                      required
                    />
                    <button type="submit">Fetch</button>
                  </div>
                </form>
                <p id="import-status" class="muted" aria-live="polite"></p>
              </section>
              <ListingForm
                action="/api/listings/create"
                submitLabel="Save listing"
                localeId={locale.id}
                photoStoredCap={photoStoredCap}
              />
            </>
          )
        }
      </div>
    </div>
  </div>

  {hasCenter && <script src="/scripts/locale-map.js" type="module"></script>}
  <script
    define:vars={{
      listingCapReached,
      listingCapMessage,
    }}
  >
    window.__WAYHOME_LISTING_CAP__ = {
      blocked: listingCapReached,
      message: listingCapReached ? listingCapMessage : null,
    };
  </script>
  <script src="/scripts/listings-sort.js" type="module"></script>
  <script src="/scripts/listing-detail.js" type="module"></script>
  <script src="/scripts/listing-import.js" type="module"></script>
</AppLayout>
