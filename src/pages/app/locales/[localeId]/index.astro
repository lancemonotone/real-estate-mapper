---
import { getLocaleForNestMember, localeNeedsSetup } from '../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const radiusMiles = Math.round((locale.radius_m / 1609.344) * 10) / 10;
const base = `/app/locales/${locale.id}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{locale.name} — Wayhome</title>
  </head>
  <body>
    <header>
      <p><a href="/app">← Nest</a></p>
      <h1>{locale.name}</h1>
      {
        locale.center_label && (
          <p>
            Center: {locale.center_label} · ~{radiusMiles} mi radius
          </p>
        )
      }
      {
        !locale.center_label && !localeNeedsSetup(locale) && (
          <p>
            Center: {locale.center_lat.toFixed(4)}, {locale.center_lng.toFixed(4)} · ~{radiusMiles}{' '}
            mi radius
          </p>
        )
      }
      {
        localeNeedsSetup(locale) && (
          <p role="alert">
            This Locale needs a real center. <a href={`${base}/edit`}>Edit Locale</a> and search a
            place name.
          </p>
        )
      }
      <p><a href={`${base}/edit`}>Edit Locale</a></p>
      <nav>
        <a href={`${base}/listings`}>Listings</a>
        <a href={`${base}/unscheduled`}>Unscheduled</a>
        <a href={`${base}/tours`}>Tours</a>
      </nav>
    </header>
  </body>
</html>
