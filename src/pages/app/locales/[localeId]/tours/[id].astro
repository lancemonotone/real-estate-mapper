---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import FavoriteHeart from '../../../../../components/FavoriteHeart.astro';
import {
  filterListingStops,
  isTourDayVisible,
} from '../../../../../lib/nest/entitlements';
import { getVisibleLocaleContext } from '../../../../../lib/supabase/nest';
import { formatTourDate } from '../../../../../lib/tours/format-tour-date';
import { toTimeInputValue } from '../../../../../lib/tours/appointment-order';
import {
  tourEndGlyph,
  tourListingStopGlyph,
  tourStartGlyph,
} from '../../../../../lib/tours/stop-glyph';
import {
  routeSignatureForListingIds,
  sameRouteSignature,
} from '../../../../../lib/tours/route-signature';

const { localeId, id } = Astro.params;
const supabase = Astro.locals.supabase!;

const { data: tour } = await supabase.from('tour_days').select('*').eq('id', id!).single();
if (!tour || (localeId && tour.locale_id !== localeId)) {
  return new Response('Not found', { status: 404 });
}

const localeContext = await getVisibleLocaleContext(supabase, tour.locale_id);
if (!localeContext) return new Response('Not found', { status: 404 });

const { locale, snapshot } = localeContext;
if (!isTourDayVisible(snapshot, tour.id)) {
  return new Response('Not found', { status: 404 });
}

const toursBase = `/app/locales/${tour.locale_id}/tours`;
const base = `/app/locales/${tour.locale_id}`;
const tourTitle = formatTourDate(tour.tour_date);

const { data: stopsRaw } = await supabase
  .from('tour_stops')
  .select('*, listings(*)')
  .eq('tour_day_id', tour.id)
  .order('sort_order', { ascending: true, nullsFirst: false });

const stops = filterListingStops(stopsRaw ?? [], snapshot);

const hasCustomStart = tour.start_lat != null && tour.start_lng != null;
const hasCustomEnd = tour.end_lat != null && tour.end_lng != null;
const listingCount = (stops ?? []).length;

const routeSignatureCurrent = routeSignatureForListingIds(
  (stops ?? []).map((s) => s.listing_id),
);
const routeFresh = Boolean(
  tour.encoded_polyline &&
    tour.route_signature &&
    sameRouteSignature(tour.route_signature, routeSignatureCurrent),
);
const mapPolyline = routeFresh ? (tour.encoded_polyline ?? '') : '';

const mapStops = (stops ?? [])
  .map((s, index) => ({ s, index }))
  .filter(
    ({ s }) => s.listings && s.listings.lat != null && s.listings.lng != null,
  )
  .map(({ s, index }) => {
    const { glyph, role } = tourListingStopGlyph({
      hasCustomStart,
      hasCustomEnd,
      index,
      listingCount,
    });
    return {
      id: s.listing_id,
      name: s.listings!.name || s.listings!.address || 'Stop',
      address: s.listings!.address || '',
      lat: s.listings!.lat!,
      lng: s.listings!.lng!,
      photoUrl: s.listings!.photo_url,
      sortOrder: s.sort_order,
      legDurationSec: s.leg_duration_sec,
      isStart: s.is_start,
      glyph,
      role,
      kind: 'listing',
    };
  });

const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const stopCount = (stops ?? []).length;
---
<AppLayout
  title={tourTitle}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { href: toursBase, label: 'Tours' },
    { label: tourTitle },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="tours"
  nestId={locale.nest_id}
>
  <div class="locale-hero__heading">
    <h1 class="locale-hero__name">{tourTitle}</h1>
    <span
      class="locale-hero__stop-count"
      aria-label={stopCount === 1 ? '1 stop' : `${stopCount} stops`}
    >
      {stopCount}
    </span>
    <div class="locale-hero__actions">
      <button type="button" class="button" data-tour-plan-route-open>
        Plan Route
      </button>
    </div>
  </div>

  <p id="plan-route-status" class="alert" hidden role="alert"></p>

  <section class="locale-browse">
    <div class="locale-browse__list">
      <ol class="tours-stops">
        {
          hasCustomStart && (
            <li
              class="tours-stops__item tours-stops__item--endpoint"
              data-listing-id="custom-start"
              data-map-listing="custom-start"
            >
              <span class="tour-stop-badge tour-stop-badge--endpoint" aria-hidden="true">
                {tourStartGlyph()}
              </span>
              <div class="matrix-listing tours-stops__link">
                <span class="matrix-listing__media">
                  {tour.start_place_id ? (
                    <img
                      class="matrix-listing__thumb"
                      src={`/api/places/photo?place_id=${encodeURIComponent(tour.start_place_id)}&max=160`}
                      alt=""
                      loading="lazy"
                    />
                  ) : (
                    <span
                      class="matrix-listing__thumb matrix-listing__thumb--empty"
                      aria-hidden="true"
                    >
                      No photo
                    </span>
                  )}
                </span>
                <span class="matrix-listing__text">
                  <span class="matrix-listing__name">
                    {tour.start_name || tour.start_address || 'Start'}
                  </span>
                  {tour.start_name && tour.start_address ? (
                    <span class="muted matrix-listing__address">{tour.start_address}</span>
                  ) : null}
                </span>
              </div>
            </li>
          )
        }
        {(stops ?? []).map((stop, index) => {
          const listing = stop.listings;
          const title = listing?.name || listing?.address || stop.listing_id;
          const photo = listing?.photo_url;
          const href = listing ? `${base}/listings/${stop.listing_id}` : null;
          const { glyph, role } = tourListingStopGlyph({
            hasCustomStart,
            hasCustomEnd,
            index,
            listingCount,
          });
          const badgeClass =
            role === 'stop'
              ? 'tour-stop-badge tour-stop-badge--stop'
              : 'tour-stop-badge tour-stop-badge--endpoint';
          return (
            <li
              class="tours-stops__item"
              data-listing-id={stop.listing_id}
              data-map-listing={stop.listing_id}
            >
              <span class={badgeClass} aria-hidden="true">
                {glyph}
              </span>
              {href ? (
                <div class="matrix-listing tours-stops__link">
                  {photo ? (
                    <button
                      type="button"
                      class="matrix-listing__media"
                      data-listing-gallery
                      data-photo-urls={JSON.stringify(
                        listing?.photo_urls?.length
                          ? listing.photo_urls
                          : [photo],
                      )}
                      data-photo-index="0"
                      aria-label={`Photos: ${title}`}
                    >
                      <img class="matrix-listing__thumb" src={photo} alt="" loading="lazy" />
                    </button>
                  ) : (
                    <span
                      class="matrix-listing__thumb matrix-listing__thumb--empty"
                      aria-hidden="true"
                    >
                      No photo
                    </span>
                  )}
                  <a class="matrix-listing__text" href={href}>
                    <span class="matrix-listing__name">{title}</span>
                    {listing?.address && listing?.name ? (
                      <span class="muted matrix-listing__address">{listing.address}</span>
                    ) : null}
                    {listing?.phone ? (
                      <span class="muted matrix-listing__phone">{listing.phone}</span>
                    ) : null}
                    {stop.leg_duration_sec != null ? (
                      <span class="muted matrix-listing__address">
                        Next leg ~{Math.round(stop.leg_duration_sec / 60)} min
                      </span>
                    ) : null}
                  </a>
                </div>
              ) : (
                <div class="tours-stops__main">
                  <strong class="listing-row__name">{title}</strong>
                </div>
              )}
              <div class="tours-stops__actions">
                <label class="tours-stops__time-label">
                  <span class="visually-hidden">Appointment time</span>
                  <input
                    type="time"
                    class="tours-stops__time"
                    data-appointment-time
                    data-listing-id={stop.listing_id}
                    value={toTimeInputValue(stop.appointment_time)}
                  />
                </label>
                <FavoriteHeart
                  listingId={stop.listing_id}
                  favorited={Boolean(listing?.is_favorite)}
                />
                {!hasCustomStart && !stop.is_start && (
                  <form method="post" action="/api/tours/set-start">
                    <input type="hidden" name="tour_day_id" value={tour.id} />
                    <input type="hidden" name="listing_id" value={stop.listing_id} />
                    <button
                      type="submit"
                      class="tour-stop-badge tour-stop-badge--endpoint tour-stop-set-start"
                      title="Set as start"
                      aria-label="Set as start"
                    >
                      {tourStartGlyph()}
                    </button>
                  </form>
                )}
                <form method="post" action="/api/tours/unassign">
                  <input type="hidden" name="tour_day_id" value={tour.id} />
                  <input type="hidden" name="listing_id" value={stop.listing_id} />
                  <input type="hidden" name="locale_id" value={locale.id} />
                  <button
                    type="submit"
                    class="secondary icon-btn"
                    title="Remove from tour"
                    aria-label="Remove from tour"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 6l12 12"></path>
                      <path d="M18 6L6 18"></path>
                    </svg>
                  </button>
                </form>
              </div>
            </li>
          );
        })}
        {
          hasCustomEnd && (
            <li
              class="tours-stops__item tours-stops__item--endpoint"
              data-listing-id="custom-end"
              data-map-listing="custom-end"
            >
              <span class="tour-stop-badge tour-stop-badge--endpoint" aria-hidden="true">
                {tourEndGlyph()}
              </span>
              <div class="matrix-listing tours-stops__link">
                <span class="matrix-listing__media">
                  {tour.end_place_id ? (
                    <img
                      class="matrix-listing__thumb"
                      src={`/api/places/photo?place_id=${encodeURIComponent(tour.end_place_id)}&max=160`}
                      alt=""
                      loading="lazy"
                    />
                  ) : (
                    <span
                      class="matrix-listing__thumb matrix-listing__thumb--empty"
                      aria-hidden="true"
                    >
                      No photo
                    </span>
                  )}
                </span>
                <span class="matrix-listing__text">
                  <span class="matrix-listing__name">
                    {tour.end_name || tour.end_address || 'End'}
                  </span>
                  {tour.end_name && tour.end_address ? (
                    <span class="muted matrix-listing__address">{tour.end_address}</span>
                  ) : null}
                </span>
              </div>
            </li>
          )
        }
      </ol>
      {
        stopCount === 0 && !hasCustomStart && !hasCustomEnd ? (
          <p class="muted">No stops on this tour day yet.</p>
        ) : null
      }
    </div>

    <div class="locale-browse__map">
      <div
        id="tour-map"
        class="map-well locale-browse__map-well"
        data-stops={JSON.stringify(mapStops)}
        data-key={browserKey}
        data-map-id={mapId}
        data-polyline={mapPolyline}
        data-custom-start={hasCustomStart
          ? JSON.stringify({
              lat: tour.start_lat,
              lng: tour.start_lng,
              address: tour.start_address,
              name: tour.start_name,
            })
          : ''}
        data-custom-end={hasCustomEnd
          ? JSON.stringify({
              lat: tour.end_lat,
              lng: tour.end_lng,
              address: tour.end_address,
              name: tour.end_name,
            })
          : ''}
      ></div>
    </div>
  </section>

  <div
    id="tour-plan-route-overlay"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="tour-plan-route-title"
  >
    <div class="compare-column-overlay__backdrop" data-tour-plan-route-close></div>
    <div class="compare-column-overlay__panel glass">
      <header class="compare-column-overlay__header">
        <h2 id="tour-plan-route-title">Plan Route</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-tour-plan-route-close
          aria-label="Close"
          title="Close"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
          </svg>
        </button>
      </header>
      <p class="muted">
        Optional custom start/end. Leave blank to use a listing. Go saves endpoints and optimizes the
        stop order.
      </p>
      <form
        method="post"
        action="/api/tours/endpoints"
        class="stack"
        data-tour-plan-route-form
      >
        <input type="hidden" name="tour_day_id" value={tour.id} />
        <label>
          Custom start address
          <div class="place-search" id="plan-route-start-search">
            <span class="field-clearable">
              <input
                type="search"
                name="start_address"
                value={tour.start_address ?? ''}
                placeholder="Search nearby…"
                autocomplete="off"
                data-place-search-input
                data-clearable-input
                data-clear-flag-name="clear_start"
                data-had-saved={hasCustomStart ? '1' : '0'}
              />
              <button
                type="button"
                class="field-clearable__clear"
                data-clearable-clear
                title="Clear"
                aria-label="Clear custom start"
                hidden
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M6 6l12 12"></path>
                  <path d="M18 6L6 18"></path>
                </svg>
              </button>
              <input type="hidden" name="clear_start" value="" data-clearable-flag />
            </span>
            <input type="hidden" name="start_lat" value={hasCustomStart ? String(tour.start_lat) : ''} data-endpoint-lat />
            <input type="hidden" name="start_lng" value={hasCustomStart ? String(tour.start_lng) : ''} data-endpoint-lng />
            <input type="hidden" name="start_name" value={tour.start_name ?? ''} data-endpoint-name />
            <input type="hidden" name="start_place_id" value={tour.start_place_id ?? ''} data-endpoint-place-id />
            <ul class="place-search__results stack" data-place-search-results hidden></ul>
            <p class="alert" data-place-search-error hidden></p>
          </div>
        </label>
        <label>
          Custom end address
          <div class="place-search" id="plan-route-end-search">
            <span class="field-clearable">
              <input
                type="search"
                name="end_address"
                value={tour.end_address ?? ''}
                placeholder="Search nearby…"
                autocomplete="off"
                data-place-search-input
                data-clearable-input
                data-clear-flag-name="clear_end"
                data-had-saved={hasCustomEnd ? '1' : '0'}
              />
              <button
                type="button"
                class="field-clearable__clear"
                data-clearable-clear
                title="Clear"
                aria-label="Clear custom end"
                hidden
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M6 6l12 12"></path>
                  <path d="M18 6L6 18"></path>
                </svg>
              </button>
              <input type="hidden" name="clear_end" value="" data-clearable-flag />
            </span>
            <input type="hidden" name="end_lat" value={hasCustomEnd ? String(tour.end_lat) : ''} data-endpoint-lat />
            <input type="hidden" name="end_lng" value={hasCustomEnd ? String(tour.end_lng) : ''} data-endpoint-lng />
            <input type="hidden" name="end_name" value={tour.end_name ?? ''} data-endpoint-name />
            <input type="hidden" name="end_place_id" value={tour.end_place_id ?? ''} data-endpoint-place-id />
            <ul class="place-search__results stack" data-place-search-results hidden></ul>
            <p class="alert" data-place-search-error hidden></p>
          </div>
        </label>
        <button type="submit">Go</button>
      </form>
    </div>
  </div>

  <script define:vars={{ tourId: tour.id, localeId: locale.id }}>
    window.__WAYHOME_TOUR_DAY__ = { tourId, localeId };
  </script>
  <script src="/scripts/tour-map.js" type="module"></script>
  <script src="/scripts/tours-day.js" type="module"></script>
  <script>
    import { bindListingGalleries } from '../../../../../client/listing-gallery';
    bindListingGalleries();
  </script>
</AppLayout>
