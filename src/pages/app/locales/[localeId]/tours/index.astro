---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import FavoriteHeart from '../../../../../components/FavoriteHeart.astro';
import TourWeekCalendar from '../../../../../components/TourWeekCalendar.astro';
import '../../../../../styles/locale-map.css';
import { milesToMeters, nearestAllowedRadiusMiles } from '../../../../../lib/geo/locale-radius';
import { getLocaleForNestMember, localeNeedsSetup } from '../../../../../lib/supabase/nest';
import { formatShortTourDate, formatTourDate } from '../../../../../lib/tours/format-tour-date';
import { toTimeInputValue } from '../../../../../lib/tours/appointment-order';
import {
  tourEndGlyph,
  tourListingStopGlyph,
  tourStartGlyph,
} from '../../../../../lib/tours/stop-glyph';
import { parseDateKey, weekDateKeys } from '../../../../../lib/tours/week';
import {
  routeSignatureForListingIds,
  sameRouteSignature,
} from '../../../../../lib/tours/route-signature';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const base = `/app/locales/${locale.id}`;
const toursBase = `${base}/tours`;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const hasCenter = !localeNeedsSetup(locale);
const radiusMiles = nearestAllowedRadiusMiles(locale.radius_m);

const dayParam = Astro.url.searchParams.get('day');
const dayParamValid =
  dayParam && /^\d{4}-\d{2}-\d{2}$/.test(dayParam) ? dayParam : null;

const { data: tours } = await supabase
  .from('tour_days')
  .select('*')
  .eq('locale_id', locale.id)
  .order('tour_date', { ascending: true });

const tourDayIds = (tours ?? []).map((t) => t.id);
const { data: allStops } =
  tourDayIds.length > 0
    ? await supabase
        .from('tour_stops')
        .select('*, listings(*)')
        .in('tour_day_id', tourDayIds)
        .order('sort_order', { ascending: true, nullsFirst: false })
    : { data: [] as never[] };

const stopsByDay = new Map<string, NonNullable<typeof allStops>>();
for (const stop of allStops ?? []) {
  const list = stopsByDay.get(stop.tour_day_id) ?? [];
  list.push(stop);
  stopsByDay.set(stop.tour_day_id, list);
}

const daysByDate: Record<string, { id: string; stopCount: number }> = {};
for (const tour of tours ?? []) {
  daysByDate[tour.tour_date] = {
    id: tour.id,
    stopCount: (stopsByDay.get(tour.id) ?? []).length,
  };
}

const firstScheduledDate =
  (tours ?? []).find((t) => (stopsByDay.get(t.id) ?? []).length > 0)?.tour_date ??
  null;
const selectedDate = dayParamValid ?? firstScheduledDate;
const weekAnchor = selectedDate ? parseDateKey(selectedDate) : new Date();
const weekKeys = weekDateKeys(weekAnchor);
const weekLabel = `${formatShortTourDate(weekKeys[0]!)} → ${formatShortTourDate(weekKeys[6]!)}`;

const assignedIds = new Set((allStops ?? []).map((s) => s.listing_id));

const { data: listings } = await supabase
  .from('listings')
  .select('id, name, address, phone, lat, lng, photo_path, photo_url, photo_urls, is_favorite')
  .eq('locale_id', locale.id)
  .order('created_at', { ascending: false });

const unassigned = (listings ?? []).filter((l) => !assignedIds.has(l.id));
const railExpanded = unassigned.length > 0;

const selectedTour = selectedDate
  ? (tours ?? []).find((t) => t.tour_date === selectedDate) ?? null
  : null;
const selectedStops = selectedTour ? (stopsByDay.get(selectedTour.id) ?? []) : [];
const hasCustomStart =
  selectedTour?.start_lat != null && selectedTour?.start_lng != null;
const hasCustomEnd = selectedTour?.end_lat != null && selectedTour?.end_lng != null;
const listingCount = selectedStops.length;

const mapStops = selectedStops
  .map((s, index) => ({ s, index }))
  .filter(({ s }) => s.listings && s.listings.lat != null && s.listings.lng != null)
  .map(({ s, index }) => {
    const { glyph, role } = tourListingStopGlyph({
      hasCustomStart,
      hasCustomEnd,
      index,
      listingCount,
    });
    return {
      id: s.listing_id,
      name: s.listings!.name || s.listings!.address || 'Stop',
      address: s.listings!.address || '',
      lat: s.listings!.lat!,
      lng: s.listings!.lng!,
      photoUrl: s.listings!.photo_url,
      sortOrder: s.sort_order,
      legDurationSec: s.leg_duration_sec,
      isStart: s.is_start,
      glyph,
      role,
      kind: 'listing',
    };
  });

const mapListings = (listings ?? [])
  .filter((l) => l.lat != null && l.lng != null)
  .map((l) => ({
    id: l.id,
    name: l.name || l.address || 'Listing',
    address: l.address || '',
    lat: l.lat!,
    lng: l.lng!,
    photoUrl: l.photo_url,
  }));

const routeSignatureCurrent = routeSignatureForListingIds(
  selectedStops.map((s) => s.listing_id),
);
const routeSignatureStored = selectedTour?.route_signature ?? '';
const routeFresh = Boolean(
  selectedTour?.encoded_polyline &&
    routeSignatureStored &&
    sameRouteSignature(routeSignatureStored, routeSignatureCurrent),
);
const mapPolyline = routeFresh ? (selectedTour?.encoded_polyline ?? '') : '';

const needsAutoroute = Boolean(
  selectedTour &&
    selectedStops.length > 0 &&
    !routeFresh &&
    (selectedStops.length >= 2 || hasCustomEnd),
);

const seed = {
  localeId: locale.id,
  toursBase,
  selectedDate,
  weekStart: weekKeys[0],
  needsAutoroute,
  selectedTourId: selectedTour?.id ?? null,
  routeStopSignature: routeSignatureCurrent,
};
---
<AppLayout
  title={`Tours — ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { label: 'Tours' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="tours"
>
  <header class="compare-header">
    <div class="compare-header__titles">
      <div class="compare-header__title-row">
        <h1 class="compare-header__title">Tours</h1>
        <p
          id="tours-calendar-status"
          class="alert compare-header__status is-empty"
          role="status"
          aria-live="polite"
        ></p>
      </div>
      <p class="muted compare-header__sub">
        Drag listings onto tour days and set the stop order for each day.
      </p>
    </div>
  </header>

  <div class="tours-workspace" data-tours-workspace>
    <aside
      class:list={['tours-workspace__rail', !railExpanded && 'is-collapsed']}
      data-tours-rail
    >
      <div class="tours-workspace__rail-head">
        <h2 class="tours-workspace__rail-title">Unscheduled ({unassigned.length})</h2>
        <button
          type="button"
          class="secondary icon-btn tours-workspace__rail-toggle"
          data-tours-rail-toggle
          aria-expanded={railExpanded ? 'true' : 'false'}
          aria-label={railExpanded ? 'Collapse unscheduled' : 'Expand unscheduled'}
          title={railExpanded ? 'Collapse' : 'Expand'}
        >
          <svg class="tours-workspace__rail-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6"></path>
          </svg>
        </button>
      </div>
      <div class="tours-workspace__rail-body" data-tours-rail-body>
        {
          unassigned.length > 0 ? (
            <div class="tours-auto-plan stack" data-tours-auto-plan-root>
              <label class="tours-auto-plan__field">
                <span class="muted">From</span>
                <input
                  type="date"
                  data-auto-plan-start
                  value={weekKeys[0]}
                  required
                />
              </label>
              <label class="tours-auto-plan__field">
                <span class="muted">To</span>
                <input
                  type="date"
                  data-auto-plan-end
                  value={weekKeys[6]}
                  required
                />
              </label>
              <div class="tours-auto-plan__actions">
                <button type="button" class="secondary" data-tours-auto-plan>
                  Preview
                </button>
                <button type="button" class="button" data-tours-auto-plan-apply hidden>
                  Apply
                </button>
              </div>
            </div>
          ) : (
            <p class="muted">No unscheduled listings.</p>
          )
        }
        <p class="muted" id="auto-plan-hint" hidden></p>
        <div id="auto-plan-clusters" class="tours-workspace__clusters stack" hidden></div>
        <ul class="tours-stops tours-workspace__unscheduled" data-tours-unscheduled>
          {
            unassigned.map((listing) => {
              const title = listing.name || listing.address || 'Untitled';
              const href = `${base}/listings/${listing.id}`;
              return (
                <li
                  class="tours-stops__item"
                  draggable="true"
                  data-listing-id={listing.id}
                  data-map-listing={listing.id}
                  data-drag-kind="listing"
                >
                  <div class="matrix-listing tours-stops__link">
                    {listing.photo_url ? (
                      <button
                        type="button"
                        class="matrix-listing__media"
                        data-listing-gallery
                        data-photo-urls={JSON.stringify(
                          listing.photo_urls?.length
                            ? listing.photo_urls
                            : [listing.photo_url],
                        )}
                        data-photo-index="0"
                        aria-label={`Photos: ${title}`}
                      >
                        <img
                          class="matrix-listing__thumb"
                          src={listing.photo_url}
                          alt=""
                          loading="lazy"
                        />
                      </button>
                    ) : (
                      <span
                        class="matrix-listing__thumb matrix-listing__thumb--empty"
                        aria-hidden="true"
                      >
                        No photo
                      </span>
                    )}
                    <a class="matrix-listing__text" href={href}>
                      <span class="matrix-listing__name">{title}</span>
                      {listing.address && listing.name ? (
                        <span class="muted matrix-listing__address">{listing.address}</span>
                      ) : null}
                      {listing.phone ? (
                        <span class="muted matrix-listing__phone">{listing.phone}</span>
                      ) : null}
                    </a>
                  </div>
                  <div class="tours-stops__actions">
                    <FavoriteHeart
                      listingId={listing.id}
                      favorited={Boolean(listing.is_favorite)}
                    />
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </aside>

    <div class="tours-workspace__main">
      <TourWeekCalendar
        weekKeys={weekKeys}
        daysByDate={daysByDate}
        selectedDate={selectedDate}
        weekLabel={weekLabel}
        jumpValue={selectedDate ?? weekKeys[0]!}
      />

      <section class="tours-workspace__day" data-tours-day-panel>
        {
          selectedTour ? (
            <>
              <div class="tours-workspace__day-head">
                <h2 class="tours-workspace__day-title">
                  {formatTourDate(selectedTour.tour_date)}
                </h2>
                <span
                  class="locale-hero__stop-count"
                  aria-label={
                    listingCount === 1 ? '1 stop' : `${listingCount} stops`
                  }
                >
                  {listingCount}
                </span>
                <div class="tours-workspace__day-actions">
                  <button
                    type="button"
                    class="tour-stop-badge tour-stop-badge--endpoint"
                    data-tours-se-open="start"
                    title="Custom start"
                    aria-label="Custom start"
                  >
                    {tourStartGlyph()}
                  </button>
                  <button
                    type="button"
                    class="tour-stop-badge tour-stop-badge--endpoint"
                    data-tours-se-open="end"
                    title="Custom end"
                    aria-label="Custom end"
                  >
                    {tourEndGlyph()}
                  </button>
                </div>
              </div>
              <ol class="tours-stops" data-tours-stops data-tour-day-id={selectedTour.id}>
                {hasCustomStart && (
                  <li
                    class="tours-stops__item tours-stops__item--endpoint"
                    data-listing-id="custom-start"
                    data-map-listing="custom-start"
                  >
                    <span class="tour-stop-badge tour-stop-badge--endpoint" aria-hidden="true">
                      {tourStartGlyph()}
                    </span>
                    <div class="matrix-listing tours-stops__link">
                      <span class="matrix-listing__text">
                        <span class="matrix-listing__name">
                          {selectedTour.start_name ||
                            selectedTour.start_address ||
                            'Start'}
                        </span>
                      </span>
                    </div>
                  </li>
                )}
                {selectedStops.map((stop, index) => {
                  const listing = stop.listings;
                  const title = listing?.name || listing?.address || stop.listing_id;
                  const photo = listing?.photo_url;
                  const href = listing ? `${base}/listings/${stop.listing_id}` : null;
                  const { glyph, role } = tourListingStopGlyph({
                    hasCustomStart,
                    hasCustomEnd,
                    index,
                    listingCount,
                  });
                  const badgeClass =
                    role === 'stop'
                      ? 'tour-stop-badge tour-stop-badge--stop'
                      : 'tour-stop-badge tour-stop-badge--endpoint';
                  return (
                    <li
                      class="tours-stops__item"
                      draggable="true"
                      data-listing-id={stop.listing_id}
                      data-map-listing={stop.listing_id}
                      data-drag-kind="listing"
                    >
                      <span class={badgeClass} aria-hidden="true">
                        {glyph}
                      </span>
                      {href ? (
                        <div class="matrix-listing tours-stops__link">
                          {photo ? (
                            <button
                              type="button"
                              class="matrix-listing__media"
                              data-listing-gallery
                              data-photo-urls={JSON.stringify(
                                listing?.photo_urls?.length
                                  ? listing.photo_urls
                                  : [photo],
                              )}
                              data-photo-index="0"
                              aria-label={`Photos: ${title}`}
                            >
                              <img
                                class="matrix-listing__thumb"
                                src={photo}
                                alt=""
                                loading="lazy"
                              />
                            </button>
                          ) : (
                            <span
                              class="matrix-listing__thumb matrix-listing__thumb--empty"
                              aria-hidden="true"
                            >
                              No photo
                            </span>
                          )}
                          <a class="matrix-listing__text" href={href}>
                            <span class="matrix-listing__name">{title}</span>
                            {listing?.address && listing?.name ? (
                              <span class="muted matrix-listing__address">{listing.address}</span>
                            ) : null}
                            {listing?.phone ? (
                              <span class="muted matrix-listing__phone">{listing.phone}</span>
                            ) : null}
                          </a>
                        </div>
                      ) : (
                        <div class="tours-stops__main">
                          <strong>{title}</strong>
                        </div>
                      )}
                      <div class="tours-stops__actions">
                        <label class="tours-stops__time-label">
                          <span class="visually-hidden">Appointment time</span>
                          <input
                            type="time"
                            class="tours-stops__time"
                            data-appointment-time
                            data-listing-id={stop.listing_id}
                            value={toTimeInputValue(stop.appointment_time)}
                          />
                        </label>
                        <FavoriteHeart
                          listingId={stop.listing_id}
                          favorited={Boolean(listing?.is_favorite)}
                        />
                        {!hasCustomStart && !stop.is_start && (
                          <form method="post" action="/api/tours/set-start">
                            <input type="hidden" name="tour_day_id" value={selectedTour.id} />
                            <input type="hidden" name="listing_id" value={stop.listing_id} />
                            <button
                              type="submit"
                              class="tour-stop-badge tour-stop-badge--endpoint tour-stop-set-start"
                              title="Set as start"
                              aria-label="Set as start"
                            >
                              {tourStartGlyph()}
                            </button>
                          </form>
                        )}
                        <button
                          type="button"
                          class="secondary icon-btn"
                          data-tours-unassign={stop.listing_id}
                          title="Remove from tour"
                          aria-label="Remove from tour"
                        >
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M6 6l12 12"></path>
                            <path d="M18 6L6 18"></path>
                          </svg>
                        </button>
                      </div>
                    </li>
                  );
                })}
                {hasCustomEnd && (
                  <li
                    class="tours-stops__item tours-stops__item--endpoint"
                    data-listing-id="custom-end"
                    data-map-listing="custom-end"
                  >
                    <span class="tour-stop-badge tour-stop-badge--endpoint" aria-hidden="true">
                      {tourEndGlyph()}
                    </span>
                    <div class="matrix-listing tours-stops__link">
                      <span class="matrix-listing__text">
                        <span class="matrix-listing__name">
                          {selectedTour.end_name || selectedTour.end_address || 'End'}
                        </span>
                      </span>
                    </div>
                  </li>
                )}
              </ol>
              {listingCount === 0 && !hasCustomStart && !hasCustomEnd ? (
                <p class="muted">No stops on this day. Drop listings here from the rail.</p>
              ) : null}
            </>
          ) : selectedDate ? (
            <p class="muted">
              No tour on {formatTourDate(selectedDate)}. Drop listings onto this date to create
              one.
            </p>
          ) : (
            <p class="muted">Select a day on the calendar, or drop a listing onto a date.</p>
          )
        }
      </section>
    </div>

    <div class="tours-workspace__map">
      {
        selectedTour && (mapStops.length > 0 || hasCustomStart || hasCustomEnd) ? (
          <div
            id="tour-map"
            class="map-well locale-browse__map-well"
            data-stops={JSON.stringify(mapStops)}
            data-key={browserKey}
            data-map-id={mapId}
            data-polyline={mapPolyline}
            data-rev={[
              mapPolyline,
              ...mapStops.map((s) => s.id),
            ].join('|')}
            data-custom-start={
              hasCustomStart
                ? JSON.stringify({
                    lat: selectedTour.start_lat,
                    lng: selectedTour.start_lng,
                    address: selectedTour.start_address,
                    name: selectedTour.start_name,
                  })
                : ''
            }
            data-custom-end={
              hasCustomEnd
                ? JSON.stringify({
                    lat: selectedTour.end_lat,
                    lng: selectedTour.end_lng,
                    address: selectedTour.end_address,
                    name: selectedTour.end_name,
                  })
                : ''
            }
          ></div>
        ) : hasCenter ? (
          <div
            id="locale-map"
            class="locale-map map-well locale-browse__map-well"
            data-key={browserKey}
            data-map-id={mapId}
            data-lat={String(locale.center_lat)}
            data-lng={String(locale.center_lng)}
            data-radius-m={String(milesToMeters(radiusMiles))}
            data-title={locale.name}
            data-listings={JSON.stringify(mapListings)}
          ></div>
        ) : (
          <p class="muted">No map until a center place is set.</p>
        )
      }
    </div>
  </div>

  <div
    id="tours-conflict-overlay"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="tours-conflict-title"
  >
    <div class="compare-column-overlay__backdrop" data-tours-conflict-close></div>
    <div class="compare-column-overlay__panel glass">
      <header class="compare-column-overlay__header">
        <h2 id="tours-conflict-title">That day already has stops</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-tours-conflict-close
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
          </svg>
        </button>
      </header>
      <p class="muted">
        Merge keeps existing stops and adds the new ones. Replace moves this day’s current stops
        back to unscheduled.
      </p>
      <div class="tours-workspace__conflict-actions">
        <button type="button" class="button" data-tours-conflict-mode="merge">Merge</button>
        <button type="button" class="secondary" data-tours-conflict-mode="replace">
          Replace
        </button>
        <button type="button" class="secondary" data-tours-conflict-close>Cancel</button>
      </div>
    </div>
  </div>

  <div
    id="tours-info-overlay"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="tours-info-title"
  >
    <div class="compare-column-overlay__backdrop" data-tours-info-close></div>
    <div class="compare-column-overlay__panel glass">
      <header class="compare-column-overlay__header">
        <h2 id="tours-info-title">Scheduling tips</h2>
        <button type="button" class="secondary icon-btn" data-tours-info-close aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
          </svg>
        </button>
      </header>
      <ul class="stack">
        <li>Click a date to select it and see stops under the week.</li>
        <li>Drag listings from Unscheduled onto a date to schedule them.</li>
        <li>Drag a numbered day circle to move a whole tour.</li>
        <li>On a phone, tap a listing then tap a date.</li>
        <li>Keyboard: focus a listing, Space to pick it up, arrow to a day, Space to drop.</li>
      </ul>
    </div>
  </div>

  {
    selectedTour && (
      <div
        id="tours-se-overlay"
        class="compare-column-overlay"
        hidden
        role="dialog"
        aria-modal="true"
        aria-labelledby="tours-se-title"
      >
        <div class="compare-column-overlay__backdrop" data-tours-se-close></div>
        <div class="compare-column-overlay__panel glass">
          <header class="compare-column-overlay__header">
            <h2 id="tours-se-title">Custom start / end</h2>
            <button
              type="button"
              class="secondary icon-btn"
              data-tours-se-close
              aria-label="Close"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12"></path>
                <path d="M18 6L6 18"></path>
              </svg>
            </button>
          </header>
          <form method="post" action="/api/tours/endpoints" class="stack" data-tours-se-form>
            <input type="hidden" name="tour_day_id" value={selectedTour.id} />
            <label data-tours-se-field="start">
              Custom start address
              <div class="place-search" id="tours-se-start-search">
                <span class="field-clearable">
                  <input
                    type="search"
                    name="start_address"
                    value={selectedTour.start_address ?? ''}
                    placeholder="Search nearby…"
                    autocomplete="off"
                    data-place-search-input
                    data-clearable-input
                    data-clear-flag-name="clear_start"
                    data-had-saved={hasCustomStart ? '1' : '0'}
                  />
                  <button
                    type="button"
                    class="field-clearable__clear"
                    data-clearable-clear
                    title="Clear"
                    aria-label="Clear custom start"
                    hidden
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 6l12 12"></path>
                      <path d="M18 6L6 18"></path>
                    </svg>
                  </button>
                  <input type="hidden" name="clear_start" value="" data-clearable-flag />
                </span>
                <input
                  type="hidden"
                  name="start_lat"
                  value={hasCustomStart ? String(selectedTour.start_lat) : ''}
                  data-endpoint-lat
                />
                <input
                  type="hidden"
                  name="start_lng"
                  value={hasCustomStart ? String(selectedTour.start_lng) : ''}
                  data-endpoint-lng
                />
                <input
                  type="hidden"
                  name="start_name"
                  value={selectedTour.start_name ?? ''}
                  data-endpoint-name
                />
                <input
                  type="hidden"
                  name="start_place_id"
                  value={selectedTour.start_place_id ?? ''}
                  data-endpoint-place-id
                />
                <ul class="place-search__results stack" data-place-search-results hidden></ul>
                <p class="alert" data-place-search-error hidden></p>
              </div>
            </label>
            <label data-tours-se-field="end">
              Custom end address
              <div class="place-search" id="tours-se-end-search">
                <span class="field-clearable">
                  <input
                    type="search"
                    name="end_address"
                    value={selectedTour.end_address ?? ''}
                    placeholder="Search nearby…"
                    autocomplete="off"
                    data-place-search-input
                    data-clearable-input
                    data-clear-flag-name="clear_end"
                    data-had-saved={hasCustomEnd ? '1' : '0'}
                  />
                  <button
                    type="button"
                    class="field-clearable__clear"
                    data-clearable-clear
                    title="Clear"
                    aria-label="Clear custom end"
                    hidden
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 6l12 12"></path>
                      <path d="M18 6L6 18"></path>
                    </svg>
                  </button>
                  <input type="hidden" name="clear_end" value="" data-clearable-flag />
                </span>
                <input
                  type="hidden"
                  name="end_lat"
                  value={hasCustomEnd ? String(selectedTour.end_lat) : ''}
                  data-endpoint-lat
                />
                <input
                  type="hidden"
                  name="end_lng"
                  value={hasCustomEnd ? String(selectedTour.end_lng) : ''}
                  data-endpoint-lng
                />
                <input
                  type="hidden"
                  name="end_name"
                  value={selectedTour.end_name ?? ''}
                  data-endpoint-name
                />
                <input
                  type="hidden"
                  name="end_place_id"
                  value={selectedTour.end_place_id ?? ''}
                  data-endpoint-place-id
                />
                <ul class="place-search__results stack" data-place-search-results hidden></ul>
                <p class="alert" data-place-search-error hidden></p>
              </div>
            </label>
            <button type="submit" class="button">Save</button>
          </form>
        </div>
      </div>
    )
  }

  <script define:vars={{ seed }}>
    window.__WAYHOME_TOURS_CALENDAR__ = seed;
  </script>
  <script src="/scripts/tours-calendar.js" type="module"></script>
  {
    selectedTour && (mapStops.length > 0 || hasCustomStart || hasCustomEnd) ? (
      <script src="/scripts/tour-map.js" type="module"></script>
    ) : hasCenter ? (
      <script src="/scripts/locale-map.js" type="module"></script>
    ) : null
  }
  {selectedTour ? <script src="/scripts/place-search.js" type="module"></script> : null}
  <script src="/scripts/listing-favorite.js" type="module"></script>
  <script>
    import { bindListingGalleries } from '../../../../../client/listing-gallery';
    bindListingGalleries();
  </script>
</AppLayout>
