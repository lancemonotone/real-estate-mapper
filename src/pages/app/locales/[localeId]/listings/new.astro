---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import ListingForm from '../../../../../components/ListingForm.astro';
import { getLocaleForNestMember } from '../../../../../lib/supabase/nest';

const { localeId } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const base = `/app/locales/${locale.id}`;
---
<AppLayout
  title={`New listing — ${locale.name}`}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { href: base, label: 'Listings' },
    { label: 'New' },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="listings"
>
  <h1>New listing</h1>
  <section class="stack">
    <h2>Import from URL</h2>
    <form id="import-form">
      <label>Listing URL <input type="url" name="url" id="import-url" required /></label>
      <button type="submit">Fetch</button>
    </form>
    <p id="import-status" class="muted"></p>
  </section>
  <ListingForm
    action="/api/listings/create"
    submitLabel="Save listing"
    localeId={locale.id}
  />
  <script>
    const form = document.getElementById('import-form');
    const status = document.getElementById('import-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const urlInput = document.getElementById('import-url');
      const url = urlInput instanceof HTMLInputElement ? urlInput.value : '';
      if (status) status.textContent = 'Fetching…';
      const res = await fetch('/api/listings/import-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await res.json();
      const set = (name, value) => {
        const el = document.querySelector(
          `form[action="/api/listings/create"] [name="${name}"]`,
        );
        if (el && value && 'value' in el) el.value = value;
      };
      set('name', data.name);
      set('address', data.address);
      set('photo_url', data.photoUrl);
      set('source_url', data.sourceUrl);
      if (status) {
        status.textContent =
          'Import finished — empty fields mean nothing was found (nothing invented).';
      }
    });
  </script>
</AppLayout>
