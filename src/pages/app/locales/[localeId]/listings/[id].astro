---
import ListingForm from '../../../../../components/ListingForm.astro';
import '../../../../../styles/listing-map.css';
import { getLocaleForNestMember } from '../../../../../lib/supabase/nest';

const { localeId, id } = Astro.params;
const supabase = Astro.locals.supabase!;
const locale = localeId ? await getLocaleForNestMember(supabase, localeId) : null;
if (!locale) return new Response('Not found', { status: 404 });

const { data: listing } = await supabase.from('listings').select('*').eq('id', id!).single();
if (!listing || listing.locale_id !== locale.id) {
  return new Response('Not found', { status: 404 });
}

const hasLocation = listing.lat != null && listing.lng != null;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const photoUrl = listing.photo_url ?? '';
const base = `/app/locales/${locale.id}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{listing.name || 'Listing'}</title>
  </head>
  <body>
    <p><a href={`${base}/listings`}>← Listings</a></p>
    <h1>{listing.name || 'Listing'}</h1>

    {hasLocation ? (
      <div
        id="listing-map"
        class="listing-map"
        data-key={browserKey}
        data-map-id={mapId}
        data-lat={String(listing.lat)}
        data-lng={String(listing.lng)}
        data-title={listing.name || listing.address || 'Listing'}
        data-photo-url={photoUrl}
      ></div>
    ) : (
      <p class="listing-map-missing">
        No map yet — add an address and geocode (or use Retry geocode below).
      </p>
    )}

    <ListingForm
      listing={listing}
      action="/api/listings/update"
      submitLabel="Update listing"
      localeId={locale.id}
    />
    <form id="geocode-form">
      <button type="submit">Retry geocode</button>
    </form>
    <p id="geocode-status"></p>
    {hasLocation && <script src="/scripts/listing-map.js" type="module"></script>}
    <script define:vars={{ listingId: listing.id }}>
      document.getElementById('geocode-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = document.getElementById('geocode-status');
        if (status) status.textContent = 'Geocoding…';
        const res = await fetch('/api/listings/geocode', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: listingId }),
        });
        const data = await res.json();
        if (status) {
          status.textContent = data.ok
            ? `Geocoded: ${data.lat}, ${data.lng}`
            : data.error || 'Geocode failed';
        }
        if (data.ok) location.reload();
      });
    </script>
  </body>
</html>
