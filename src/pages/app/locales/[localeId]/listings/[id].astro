---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import DirectionsOverlay from '../../../../../components/DirectionsOverlay.astro';
import ListingReactions from '../../../../../components/ListingReactions.astro';
import ListingForm from '../../../../../components/ListingForm.astro';
import PlanNotice from '../../../../../components/PlanNotice.astro';
import PlaceTypePicker from '../../../../../components/PlaceTypePicker.astro';
import TourWeekCalendar from '../../../../../components/TourWeekCalendar.astro';
import '../../../../../styles/listing-map.css';
import {
  applyListingPhotoVisibility,
  buildTourCalendarContext,
  isListingVisible,
  loadNestEntitlementUi,
  PLAN_LIMITS,
  PLAN_MESSAGES,
  resolveTourDrop,
  tourCalendarClientConfig,
} from '../../../../../lib/nest/entitlements';
import { getVisibleLocaleContext } from '../../../../../lib/supabase/nest';
import { formatShortTourDate, formatTourDate } from '../../../../../lib/tours/format-tour-date';
import { formatAppointmentTime } from '../../../../../lib/tours/appointment-order';
import { parseDateKey, toDateKey, weekDateKeys } from '../../../../../lib/tours/week';
import {
  LISTING_FIELD_LABELS,
} from '../../../../../lib/listings/field-labels';
import { buildListingDisplay } from '../../../../../lib/listings/listing-display';
import { formatTravelMeta } from '../../../../../lib/listings/format-travel-meta';
import { textQueryCacheKey } from '../../../../../lib/proximity/text-query';
import IconGlyph from '../../../../../components/IconGlyph.astro';

const { localeId, id } = Astro.params;
const supabase = Astro.locals.supabase!;
const localeContext = localeId
  ? await getVisibleLocaleContext(supabase, localeId, Astro.locals.devHuntPassPreview ?? false)
  : null;
if (!localeContext) return new Response('Not found', { status: 404 });

const { locale, snapshot } = localeContext;
const user = Astro.locals.user!;
const entitlementUi = await loadNestEntitlementUi(
  supabase,
  locale.nest_id,
  user.id,
  Astro.locals.devHuntPassPreview ?? false,
  snapshot,
);

const { data: listingRaw } = await supabase.from('listings').select('*').eq('id', id!).single();
if (!listingRaw || listingRaw.locale_id !== locale.id) {
  return new Response('Not found', { status: 404 });
}
if (!isListingVisible(snapshot, listingRaw.id)) {
  return new Response('Not found', { status: 404 });
}

const listing = applyListingPhotoVisibility(listingRaw, snapshot);

const { data: listingPlaces } = await supabase
  .from('listing_places')
  .select('*')
  .eq('listing_id', listing.id)
  .order('updated_at', { ascending: false });

const { data: criteria } = await supabase
  .from('proximity_criteria')
  .select('*')
  .eq('locale_id', locale.id)
  .order('sort_order', { ascending: true })
  .order('created_at', { ascending: true });

const { data: proximityResults } = await supabase
  .from('proximity_results')
  .select('*')
  .eq('listing_id', listing.id);

const resultByCriterion = new Map((proximityResults ?? []).map((r) => [r.criterion_id, r]));

const { data: localeToursRaw } = await supabase
  .from('tour_days')
  .select('id, tour_date')
  .eq('locale_id', locale.id)
  .order('tour_date', { ascending: true });

const localeTours = (localeToursRaw ?? []).filter((day) =>
  snapshot.visibleTourDayIds.has(day.id),
);

const allLocaleTourIds = (localeToursRaw ?? []).map((t) => t.id);
const { data: allLocaleStopsForCal } =
  allLocaleTourIds.length > 0
    ? await supabase
        .from('tour_stops')
        .select('tour_day_id, listing_id')
        .in('tour_day_id', allLocaleTourIds)
    : { data: [] as { tour_day_id: string; listing_id: string }[] };

const listingTourCal = buildTourCalendarContext(
  snapshot,
  (localeToursRaw ?? []).map((day) => ({ id: day.id, tour_date: day.tour_date })),
  allLocaleStopsForCal ?? [],
);
const listingTourCalendarClient = tourCalendarClientConfig(listingTourCal);

const tourIds = (localeTours ?? []).map((t) => t.id);
let assignment: {
  tourDayId: string;
  tourDate: string;
  appointmentTime: string | null;
  hiddenOnPlan: boolean;
} | null = null;
if (allLocaleTourIds.length > 0) {
  const { data: stop } = await supabase
    .from('tour_stops')
    .select('tour_day_id, appointment_time')
    .eq('listing_id', listing.id)
    .in('tour_day_id', allLocaleTourIds)
    .limit(1)
    .maybeSingle();
  if (stop) {
    const day = (localeToursRaw ?? []).find((t) => t.id === stop.tour_day_id);
    if (day) {
      assignment = {
        tourDayId: day.id,
        tourDate: day.tour_date,
        appointmentTime: (stop.appointment_time as string | null) ?? null,
        hiddenOnPlan: !snapshot.visibleTourDayIds.has(day.id),
      };
    }
  }
}

const { data: tourStopCounts } =
  tourIds.length > 0
    ? await supabase.from('tour_stops').select('tour_day_id').in('tour_day_id', tourIds)
    : { data: [] as { tour_day_id: string }[] };

const stopCountByDay = new Map<string, number>();
for (const row of tourStopCounts ?? []) {
  stopCountByDay.set(row.tour_day_id, (stopCountByDay.get(row.tour_day_id) ?? 0) + 1);
}

const listingTourDaysByDate: Record<string, { id: string; stopCount: number }> = {};
for (const tour of localeTours ?? []) {
  listingTourDaysByDate[tour.tour_date] = {
    id: tour.id,
    stopCount: stopCountByDay.get(tour.id) ?? 0,
  };
}
const listingTourDropBlocked = Object.fromEntries(
  Object.entries(listingTourCal.dropBlockedByDate).map(([date, block]) => [
    date,
    block.reason,
  ]),
) as Record<string, 'cap' | 'hidden'>;

const listingTourDayParam = Astro.url.searchParams.get('tourDay');
const listingTourSelected =
  listingTourDayParam && /^\d{4}-\d{2}-\d{2}$/.test(listingTourDayParam)
    ? listingTourDayParam
    : assignment?.tourDate ?? toDateKey(new Date());
const listingTourAddDecision = resolveTourDrop(listingTourCal, listingTourSelected);
const listingTourAddBlocked =
  listingTourAddDecision.ok === false ? listingTourAddDecision.message : null;
const listingTourWeekKeys = weekDateKeys(parseDateKey(listingTourSelected));
const listingTourWeekLabel = `${formatShortTourDate(listingTourWeekKeys[0]!)} → ${formatShortTourDate(listingTourWeekKeys[6]!)}`;
const assignmentTourTimeLabel = assignment?.appointmentTime
  ? formatAppointmentTime(assignment.appointmentTime)
  : null;

const selectedListingTour = (localeTours ?? []).find((t) => t.tour_date === listingTourSelected);
let selectedDayStopLabels: string[] = [];
if (selectedListingTour) {
  const { data: dayStops } = await supabase
    .from('tour_stops')
    .select('listings(name, address)')
    .eq('tour_day_id', selectedListingTour.id)
    .order('sort_order', { ascending: true, nullsFirst: false });
  selectedDayStopLabels = (dayStops ?? []).map((s) => {
    const l = s.listings as { name: string | null; address: string | null } | null;
    return l?.name || l?.address || 'Stop';
  });
}

const hasLocation = listing.lat != null && listing.lng != null;
const browserKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? '';
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID ?? '';
const photoUrl = listing.photo_url ?? '';
const photoUrls =
  listing.photo_urls?.length > 0
    ? listing.photo_urls
    : photoUrl
      ? [photoUrl]
      : [];
const photoUrlsJson = JSON.stringify(photoUrls);
const isFreePlan = snapshot.plan === 'free';
const photoStoredCap =
  snapshot.plan === 'free' ? PLAN_LIMITS.free.photosStoredPerListing : undefined;
const storedPhotoUrls =
  listingRaw.photo_urls && listingRaw.photo_urls.length > 0
    ? listingRaw.photo_urls
    : listingRaw.photo_url
      ? [listingRaw.photo_url]
      : [];
const hiddenPhotoCount = isFreePlan
  ? Math.max(0, storedPhotoUrls.length - photoUrls.length)
  : 0;
const photoPlanNote =
  isFreePlan && hiddenPhotoCount > 0
    ? PLAN_MESSAGES.photoPlanNoteWithHidden(hiddenPhotoCount)
    : isFreePlan
      ? PLAN_MESSAGES.photoPlanNoteDefault
      : null;
const base = `/app/locales/${locale.id}`;
const listingTitle = listing.name || 'Listing';

const compareRows = (criteria ?? []).map((c) => {
  const row = resultByCriterion.get(c.id);
  return {
    criterionId: c.id,
    label: c.label,
    travelMode: c.travel_mode,
    kind: c.kind,
    placeTypeKey: c.place_type_key,
    textQuery: c.text_query,
    result: row ?? null,
  };
});

/** Places to pin on the listing map (compare winners + listing-only places). */
const mapPlaces = [
  ...compareRows
    .filter(
      (row) =>
        row.result?.status === 'ok' &&
        row.result.place_lat != null &&
        row.result.place_lng != null,
    )
    .map((row) => ({
      id: `criterion:${row.criterionId}`,
      name: row.result!.place_name || row.label,
      label: row.label,
      lat: row.result!.place_lat!,
      lng: row.result!.place_lng!,
      placeId: row.result!.place_id,
    })),
  ...(listingPlaces ?? []).map((p) => ({
    id: `listing-place:${p.id}`,
    name: p.name,
    label: p.label || p.name,
    lat: p.lat,
    lng: p.lng,
    placeId: p.place_id,
  })),
];

const mapPlacesJson = JSON.stringify(mapPlaces);
const display = buildListingDisplay(listing);
const attributeFactGroups = display.factGroups.filter((group) => group.column === 'attributes');
const costFactGroups = display.factGroups.filter((group) => group.column === 'costs');
---
<AppLayout
  title={listingTitle}
  crumbs={[
    { href: '/app', label: 'Home' },
    { href: base, label: locale.name },
    { href: base, label: 'Listings' },
    { label: listingTitle },
  ]}
  locale={{ id: locale.id, name: locale.name }}
  localeSection="listings"
  nestId={locale.nest_id}
  entitlementUi={entitlementUi}
>
  <section class="listing-hero" data-listing-surface>
    <div class="listing-hero__meta stack">
      <div class="listing-hero__heading">
        <div class="locale-hero__title">
          <h1 class="locale-hero__name" data-listing-title>{listingTitle}</h1>
          <div class="locale-hero__title-actions">
            <ListingReactions
              listingId={listing.id}
              favorited={Boolean(listing.is_favorite)}
              passed={Boolean(listing.is_passed)}
              inline
            />
            <button
              type="button"
              class="listing-favorite"
              data-listing-overlay-open="edit"
              title="Edit listing"
              aria-label="Edit listing"
            >
              <IconGlyph name="pencilLine" />
            </button>
            <button
              type="button"
              class="listing-favorite listing-delete"
              data-listing-overlay-open="delete"
              title="Delete listing"
              aria-label="Delete listing"
            >
              <IconGlyph name="x" />
            </button>
          </div>
        </div>
      </div>

      <div data-listing-contact-host hidden={!(listing.address || listing.source_url || listing.phone)}>
        {
          listing.address || listing.source_url || listing.phone ? (
            <div class="listing-hero__contact stack" data-listing-contact>
              {
                listing.address || listing.source_url ? (
                  <div class="listing-hero__address-row">
                    {listing.address ? (
                      <p class="listing-hero__address" data-listing-address>{listing.address}</p>
                    ) : (
                      <p class="muted">No address yet.</p>
                    )}
                    {listing.source_url ? (
                      <a
                        class="secondary icon-btn"
                        href={listing.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="Open listing source"
                        aria-label="Open listing source"
                        data-listing-source
                      >
                        <IconGlyph name="externalLink" />
                      </a>
                    ) : null}
                  </div>
                ) : null
              }
              {
                listing.phone ? (
                  <p class="listing-hero__phone" data-listing-phone>
                    <a href={`tel:${listing.phone.replace(/[^\d+]/g, '')}`}>{listing.phone}</a>
                  </p>
                ) : null
              }
            </div>
          ) : null
        }
      </div>

      <div data-listing-cost-host hidden={!display.monthlyTotal && !display.moveInTotal}>
        {
          display.monthlyTotal || display.moveInTotal ? (
            <section class="listing-cost-summary" aria-label="Cost totals" data-listing-cost-summary>
              <dl class="listing-cost-summary__grid">
                {
                  display.monthlyTotal ? (
                    <div class="listing-cost-summary__item">
                      <dt>{LISTING_FIELD_LABELS.totalMonthly}</dt>
                      <dd>{display.monthlyTotal}</dd>
                    </div>
                  ) : null
                }
                {
                  display.moveInTotal ? (
                    <div class="listing-cost-summary__item">
                      <dt>
                        {LISTING_FIELD_LABELS.totalMoveIn}
                        {display.showMoveInDepositNote ? (
                          <span class="listing-cost-summary__qualifier"> (includes deposit)</span>
                        ) : null}
                      </dt>
                      <dd>{display.moveInTotal}</dd>
                    </div>
                  ) : null
                }
              </dl>
            </section>
          ) : null
        }
      </div>

      <div data-listing-facts-host hidden={!display.hasFactSections}>
        {
          display.hasFactSections ? (
            <div class="listing-hero__fact-sections">
              {
                attributeFactGroups.length > 0 ? (
                  <div class="listing-hero__fact-col listing-hero__fact-col--attributes">
                    {attributeFactGroups.map((group) => (
                      <div class="listing-facts-group">
                        <h2
                          class:list={[
                            'listing-section__title',
                            { 'visually-hidden': group.srOnlyTitle },
                          ]}
                        >
                          {group.title}
                        </h2>
                        <dl class="listing-facts">
                          {group.facts.map((fact) => (
                            <div class="listing-facts__row">
                              <dt>{fact.label}</dt>
                              <dd>
                                <span class:list={[{ 'listing-facts__value--prewrap': fact.prewrap }]}>
                                  {fact.value}
                                </span>
                                {fact.hint ? (
                                  <span class="listing-facts__hint muted">{fact.hint}</span>
                                ) : null}
                              </dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    ))}
                  </div>
                ) : null
              }
              {
                costFactGroups.length > 0 ? (
                  <div class="listing-hero__fact-col listing-hero__fact-col--costs">
                    {costFactGroups.map((group) => (
                      <div class="listing-facts-group">
                        <h2 class="listing-section__title">{group.title}</h2>
                        <dl class="listing-facts">
                          {group.facts.map((fact) => (
                            <div class="listing-facts__row">
                              <dt>{fact.label}</dt>
                              <dd>
                                <span class:list={[{ 'listing-facts__value--prewrap': fact.prewrap }]}>
                                  {fact.value}
                                </span>
                                {fact.hint ? (
                                  <span class="listing-facts__hint muted">{fact.hint}</span>
                                ) : null}
                              </dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    ))}
                  </div>
                ) : null
              }
            </div>
          ) : null
        }
      </div>

      <p class="muted" data-listing-empty-host hidden={display.hasFactSections || display.monthlyTotal || display.moveInTotal}>
        No attributes yet.
      </p>

      <div class="listing-hero__travel prox-saved" data-listing-travel-host>
        {
          compareRows.length === 0 && (listingPlaces ?? []).length === 0 ? (
            <>
              <h2 class="listing-section__title">Travel Times</h2>
              <p class="muted" id="listing-places-empty">
              None yet —{' '}
              <button type="button" class="linkish" data-listing-overlay-open="place">
                add a place
              </button>
              .
            </p>
            </>
          ) : (
            <div class="matrix-panel">
              <div class="matrix-panel__header">
                <div class="compare-header__top">
                  <div class="matrix-panel__titles compare-header__titles">
                    <h2 class="listing-section__title compare-header__title">Travel Times</h2>
                    <ul class="matrix-type-legend" aria-label="Place scope">
                      <li>
                        <span class="matrix-type__icon" aria-hidden="true">
                          <IconGlyph name="listCheck" />
                        </span>
                        On Travel Times
                      </li>
                      <li>
                        <span class="matrix-type__icon" aria-hidden="true">
                          <IconGlyph name="home" />
                        </span>
                        Listing only
                      </li>
                    </ul>
                  </div>
                  <div class="matrix-panel__actions compare-header__actions">
                    <button
                      type="button"
                      class="button icon-btn compare-header__add"
                      data-listing-overlay-open="place"
                      aria-label="Add place"
                      title="Add place"
                    >
                      <IconGlyph name="plus" />
                    </button>
                  </div>
                </div>
              </div>
              <div class="matrix-scroll">
              <table class="data matrix-table matrix-table--fit" aria-label="Travel Times">
                <tbody id="listing-places-list">
                  {compareRows.map((row) => {
                    const placeId = row.result?.place_id ?? '';
                    const placeName =
                      row.result?.status === 'ok' ? row.result.place_name ?? '' : '';
                    const metaLabel =
                      row.result?.status === 'ok'
                        ? formatTravelMeta(
                            row.result.duration_sec,
                            row.result.distance_m,
                          )
                        : row.result
                          ? row.result.status
                          : 'Pending…';
                    return (
                      <tr
                        class="prox-saved-item prox-saved-item--compare"
                        data-listing-prox-cell
                        data-map-listing={`criterion:${row.criterionId}`}
                        data-column-label={row.label}
                        data-listing-id={listing.id}
                        data-criterion-id={row.criterionId}
                        data-place-type-key={
                          row.kind === 'place_type'
                            ? row.placeTypeKey ?? ''
                            : row.kind === 'text_query' && row.textQuery
                              ? textQueryCacheKey(row.textQuery)
                              : ''
                        }
                        data-listing-lat={listing.lat != null ? String(listing.lat) : ''}
                        data-listing-lng={listing.lng != null ? String(listing.lng) : ''}
                        data-travel-mode={row.travelMode}
                      >
                        <th scope="row" class="matrix-table__place">
                          {row.result ? (
                            <span class="seeded" hidden>
                              {JSON.stringify(row.result)}
                            </span>
                          ) : null}
                          <div class="matrix-listing">
                            <span class="matrix-listing__media" data-prox-thumb>
                              {placeId ? (
                                <img
                                  class="matrix-listing__thumb prox-saved-item__thumb"
                                  src={`/api/places/photo?place_id=${encodeURIComponent(placeId)}&max=120`}
                                  alt=""
                                  loading="lazy"
                                  onerror="this.hidden=true"
                                />
                              ) : (
                                <span
                                  class="matrix-listing__thumb matrix-listing__thumb--empty"
                                  aria-hidden="true"
                                >
                                  No photo
                                </span>
                              )}
                            </span>
                            <div class="cell-ok__place">
                              <span class="matrix-listing__label">{row.label}</span>
                              <div class="cell-ok__name">{placeName}</div>
                              <div class="cell-ok__meta prox-cell-meta">{metaLabel}</div>
                            </div>
                            <div class="cell-actions" data-cell-actions></div>
                          </div>
                        </th>
                        <td class="matrix-type">
                          <span
                            class="matrix-type__icon"
                            title="On Travel Times"
                            aria-label="On Travel Times"
                          >
                            <IconGlyph name="listCheck" />
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                  {(listingPlaces ?? []).map((p) => (
                    <tr
                      class="prox-saved-item prox-saved-item--listing"
                      data-map-listing={`listing-place:${p.id}`}
                      data-place-row-id={p.id}
                      data-place-lat={String(p.lat)}
                      data-place-lng={String(p.lng)}
                      data-place-id={p.place_id}
                      data-place-name={p.name}
                      data-travel-mode={p.travel_mode}
                      data-duration-sec={p.duration_sec != null ? String(p.duration_sec) : ''}
                      data-distance-m={p.distance_m != null ? String(p.distance_m) : ''}
                      data-maps-url={p.maps_url ?? ''}
                    >
                      <th scope="row" class="matrix-table__place">
                        <div class="matrix-listing">
                          <span class="matrix-listing__media" data-prox-thumb>
                            {p.place_id ? (
                              <img
                                class="matrix-listing__thumb prox-saved-item__thumb"
                                src={`/api/places/photo?place_id=${encodeURIComponent(p.place_id)}&max=120`}
                                alt=""
                                loading="lazy"
                                onerror="this.hidden=true"
                              />
                            ) : (
                              <span
                                class="matrix-listing__thumb matrix-listing__thumb--empty"
                                aria-hidden="true"
                              >
                                No photo
                              </span>
                            )}
                          </span>
                          <div class="cell-ok__place">
                            <div class="cell-ok__name">{p.name}</div>
                            <div class="cell-ok__meta prox-cell-meta">
                              {[formatTravelMeta(p.duration_sec, p.distance_m), p.travel_mode]
                                .filter(Boolean)
                                .join(' · ')}
                            </div>
                          </div>
                          <div class="cell-actions" data-cell-actions></div>
                        </div>
                      </th>
                      <td class="matrix-type">
                        <span
                          class="matrix-type__icon"
                          title="Listing only"
                          aria-label="Listing only"
                        >
                          <IconGlyph name="home" />
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            </div>
          )
        }
      </div>

    </div>

    <div class="listing-hero__visual stack">
      <div class="listing-hero__tour-bar">
        <p class="listing-hero__tour locale-hero__tour-status" data-listing-tour-status>
          {
            assignment ? (
              <>
                On tour{' '}
                {
                  assignment.hiddenOnPlan ? (
                    <span>
                      {formatTourDate(assignment.tourDate)}
                      {assignmentTourTimeLabel ? ` · ${assignmentTourTimeLabel}` : ''}{' '}
                      <PlanNotice variant="chip">{PLAN_MESSAGES.tourOnHiddenDate}</PlanNotice>
                    </span>
                  ) : (
                    <a href={`${base}/tours/${assignment.tourDayId}`}>
                      {formatTourDate(assignment.tourDate)}
                      {assignmentTourTimeLabel ? ` · ${assignmentTourTimeLabel}` : ''}
                    </a>
                  )
                }
              </>
            ) : (
              <span class="muted">Not on a tour</span>
            )
          }
        </p>
        <div class="locale-hero__actions">
          <button
            type="button"
            class="secondary icon-btn"
            data-listing-overlay-open="tour"
            title="Tour"
            aria-label="Tour"
          >
            <IconGlyph name="calendar" />
          </button>
        </div>
      </div>
      {
        photoUrls.length > 0 ? (
          isFreePlan ? (
            <div class="listing-hero__gallery">
              <img
                class="listing-hero__photo"
                src={photoUrls[0]}
                alt=""
              />
              {
                hiddenPhotoCount > 0 && entitlementUi && (
                  <PlanNotice
                    variant="inline"
                    isOwner={entitlementUi.isOwner}
                    ownerDisplayName={entitlementUi.ownerDisplayName}
                    showActions={true}
                  >
                    <p class="plan-notice__text">
                      {PLAN_MESSAGES.photoHiddenOnListing(hiddenPhotoCount)}
                    </p>
                  </PlanNotice>
                )
              }
            </div>
          ) : (
            <div class="listing-hero__gallery" data-hero-gallery>
              <button
                type="button"
                class="listing-hero__photo-btn"
                data-listing-gallery
                data-photo-urls={photoUrlsJson}
                data-photo-index="0"
                aria-label="Open photo gallery"
              >
                <img
                  class="listing-hero__photo"
                  src={photoUrls[0]}
                  alt=""
                  data-hero-gallery-img
                />
              </button>
              {
                photoUrls.length > 1 && (
                  <div class="listing-hero__gallery-nav">
                    <button
                      type="button"
                      class="secondary icon-btn"
                      data-hero-gallery-prev
                      aria-label="Previous photo"
                      title="Previous photo"
                    >
                      <IconGlyph name="chevronLeft" />
                    </button>
                    <span class="muted" data-hero-gallery-count>
                      1 / {photoUrls.length}
                    </span>
                    <button
                      type="button"
                      class="secondary icon-btn"
                      data-hero-gallery-next
                      aria-label="Next photo"
                      title="Next photo"
                    >
                      <IconGlyph name="chevronRight" />
                    </button>
                  </div>
                )
              }
            </div>
          )
        ) : (
          <p class="muted">No photo</p>
        )
      }
      {
        hasLocation ? (
          <div
            id="listing-map"
            class="listing-map map-well listing-hero__map"
            data-map-state="loading"
            data-key={browserKey}
            data-map-id={mapId}
            data-listing-id={listing.id}
            data-lat={String(listing.lat)}
            data-lng={String(listing.lng)}
            data-title={listing.name || listing.address || 'Listing'}
            data-address={listing.address || ''}
            data-photo-url={photoUrl}
            data-places={mapPlacesJson}
          ></div>
        ) : (
          <p class="listing-map-missing muted">No map yet — add an address in Edit.</p>
        )
      }
    </div>
  </section>

  <!-- Delete confirm overlay -->
  <div
    id="listing-overlay-delete"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="listing-overlay-delete-title"
    data-listing-overlay="delete"
  >
    <div class="compare-column-overlay__backdrop" data-listing-overlay-close></div>
    <div class="compare-column-overlay__panel glass">
      <header class="compare-column-overlay__header">
        <h2 id="listing-overlay-delete-title">Delete this listing?</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-listing-overlay-close
          aria-label="Close"
          title="Close"
        >
          <IconGlyph name="x" />
        </button>
      </header>
      <p class="muted">
        Permanently removes {listingTitle} from this Locale, including tour stops and proximity
        data. This cannot be undone.
      </p>
      <div class="tours-workspace__conflict-actions">
        <button
          type="button"
          class="button danger"
          data-listing-delete-confirm
          data-listing-id={listing.id}
          data-locale-id={locale.id}
        >
          Delete
        </button>
        <button type="button" class="secondary" data-listing-overlay-close>Cancel</button>
      </div>
      <p class="alert" data-listing-delete-error hidden role="alert"></p>
    </div>
  </div>

  <!-- Edit overlay -->
  <div
    id="listing-overlay-edit"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="listing-overlay-edit-title"
    data-listing-overlay="edit"
  >
    <div class="compare-column-overlay__backdrop" data-listing-overlay-close></div>
    <div class="compare-column-overlay__panel glass listing-overlay__panel">
      <header class="compare-column-overlay__header">
        <h2 id="listing-overlay-edit-title">Edit listing</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-listing-overlay-close
          aria-label="Close"
          title="Close"
        >
          <IconGlyph name="x" />
        </button>
      </header>
      <div class="listing-overlay__body">
        <ListingForm
          listing={listingRaw}
          tourAssignment={assignment}
          action="/api/listings/update"
          localeId={locale.id}
          autosave
          photoPlanNote={photoPlanNote}
          photoStoredCap={photoStoredCap}
          planIsOwner={entitlementUi?.isOwner ?? true}
          planOwnerDisplayName={entitlementUi?.ownerDisplayName ?? null}
        />
      </div>
    </div>
  </div>

  <!-- Tour overlay -->
  <div
    id="listing-overlay-tour"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="listing-overlay-tour-title"
    data-listing-overlay="tour"
  >
    <div class="compare-column-overlay__backdrop" data-listing-overlay-close></div>
    <div class="compare-column-overlay__panel glass">
      <header class="compare-column-overlay__header">
        <h2 id="listing-overlay-tour-title">Tour</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-listing-overlay-close
          aria-label="Close"
          title="Close"
        >
          <IconGlyph name="x" />
        </button>
      </header>

      {
        assignment ? (
          <div class="stack" data-listing-tour-assignment>
            <p>
              Currently on{' '}
              {
                assignment.hiddenOnPlan ? (
                  <span>
                    {formatTourDate(assignment.tourDate)} (hidden on Free)
                  </span>
                ) : (
                  <a href={`${base}/tours?day=${assignment.tourDate}`}>
                    {formatTourDate(assignment.tourDate)}
                  </a>
                )
              }
              .
            </p>
            <form method="post" action="/api/tours/unassign" data-listing-tour-unassign>
              <input type="hidden" name="listing_id" value={listing.id} />
              <input type="hidden" name="tour_day_id" value={assignment.tourDayId} />
              <input type="hidden" name="locale_id" value={locale.id} />
              <input type="hidden" name="return_to" value={`${base}/listings/${listing.id}`} />
              <button type="submit" class="secondary">
                Remove from tour
              </button>
            </form>
          </div>
        ) : null
      }

      <div class="stack" data-listing-tour-calendar>
        <TourWeekCalendar
          weekKeys={listingTourWeekKeys}
          daysByDate={listingTourDaysByDate}
          selectedDate={listingTourSelected}
          idPrefix="listing-tour-week"
          weekLabel={listingTourWeekLabel}
          jumpValue={listingTourSelected}
          blockNewTourDays={!listingTourCal.canAddNewTourDay}
          dropBlocked={listingTourDropBlocked}
        />
        <div class="listing-tour-day" data-listing-tour-day-host>
          <h3 class="listing-tour-day__title">{formatTourDate(listingTourSelected)}</h3>
          {
            selectedDayStopLabels.length > 0 ? (
              <ul class="stack">
                {selectedDayStopLabels.map((label) => (
                  <li>{label}</li>
                ))}
              </ul>
            ) : (
              <p class="muted">No stops on this day yet.</p>
            )
          }
          <button
            type="button"
            class="button"
            data-listing-tour-add
            disabled={
              assignment?.tourDate === listingTourSelected ||
              Boolean(listingTourAddBlocked)
            }
            title={listingTourAddBlocked ?? undefined}
          >
            {
              assignment?.tourDate === listingTourSelected
                ? 'Already on this day'
                : listingTourAddBlocked
                  ? 'Cannot add to this day'
                  : 'Add to this day'
            }
          </button>
          {
            listingTourAddBlocked && entitlementUi && (
              <PlanNotice variant="inline" showActions={false}>
                <p class="plan-notice__text">{listingTourAddBlocked}</p>
              </PlanNotice>
            )
          }
          {
            !listingTourCal.canAddNewTourDay && snapshot.plan === 'free' && entitlementUi && (
              <PlanNotice
                variant="inline"
                isOwner={entitlementUi.isOwner}
                ownerDisplayName={entitlementUi.ownerDisplayName}
              >
                <p class="plan-notice__text">{PLAN_MESSAGES.tourDayCapAmbient('free')}</p>
              </PlanNotice>
            )
          }
          <p class="alert" id="listing-tour-status" hidden role="alert"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Add / change place overlay -->
  <div
    id="listing-overlay-place"
    class="compare-column-overlay"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="listing-overlay-place-title"
    data-listing-overlay="place"
  >
    <div class="compare-column-overlay__backdrop" data-listing-overlay-close></div>
    <div
      class="compare-column-overlay__panel glass listing-overlay__panel listing-overlay__panel--place"
    >
      <header class="compare-column-overlay__header">
        <h2 id="listing-overlay-place-title">Add place</h2>
        <button
          type="button"
          class="secondary icon-btn"
          data-listing-overlay-close
          aria-label="Close"
          title="Close"
        >
          <IconGlyph name="x" />
        </button>
      </header>
      <div class="place-picker">
        <div class="place-picker__form proximity-panel stack">
          <p class="muted prox-lede" id="prox-lede">
            Find a nearby type or search a place, then save.
          </p>
          <div class="prox-fields stack">
            <label>
              Mode
              <select id="prox-mode-kind">
                <option value="nearest">Nearest</option>
                <option value="search">Search place</option>
              </select>
            </label>
            <div id="prox-nearest-fields" class="stack">
              <label>
                Place type
                <PlaceTypePicker id="prox-place-type" value="" />
              </label>
              <p class="muted nearest-fields__or">or</p>
              <label>
                Search phrase
                <input
                  type="text"
                  id="prox-text-query"
                  placeholder="e.g. coffee shop"
                  autocomplete="off"
                />
              </label>
            </div>
            <div id="prox-search-fields" class="stack" hidden>
              <div class="place-search" id="prox-place-search">
                <label>
                  Place or address
                  <input
                    type="search"
                    data-place-search-input
                    placeholder="Place, address, or search phrase…"
                    autocomplete="off"
                  />
                </label>
                <ul class="place-search__results stack" data-place-search-results hidden></ul>
                <p class="alert" data-place-search-error hidden></p>
              </div>
            </div>
            <label>
              Travel mode
              <select id="prox-mode">
                <option value="DRIVE">Drive</option>
                <option value="WALK">Walk</option>
                <option value="BICYCLE">Bicycle</option>
                <option value="TRANSIT">Transit</option>
              </select>
            </label>
          </div>
          <div class="prox-actions">
            <button
              type="button"
              id="prox-run"
              title="Find nearby places and drive times"
            >
              Find route
            </button>
            <button
              type="button"
              id="prox-save"
              class="secondary"
              hidden
              title="Save this location"
            >
              Save
            </button>
          </div>
          <div id="prox-choices" class="prox-choices stack" hidden></div>
          <div id="prox-result" class="prox-result" hidden></div>
        </div>
        <div class="place-picker__map-col">
          <div
            id="prox-picker-map"
            class="place-picker__map map-well"
            data-key={browserKey}
            data-map-id={mapId}
            data-lat={listing.lat != null ? String(listing.lat) : ''}
            data-lng={listing.lng != null ? String(listing.lng) : ''}
            data-locale-lat={String(locale.center_lat)}
            data-locale-lng={String(locale.center_lng)}
          >
          </div>
          <p id="prox-picker-map-meta" class="place-picker__map-meta muted" hidden></p>
          <a
            id="prox-picker-maps-link"
            class="secondary icon-btn place-picker__maps-link"
            href="#"
            target="_blank"
            rel="noopener"
            hidden
            aria-label="Open in Google Maps"
            title="Open in Google Maps"
          >
            <IconGlyph name="mapPin" />
          </a>
        </div>
      </div>
    </div>
  </div>

  {hasLocation && <script src="/scripts/listing-map.js" type="module"></script>}
  <script
    define:vars={{
      listingId: listing.id,
      localeId: locale.id,
      hasLocation,
      mapKey: browserKey,
      mapId,
      localeLat: locale.center_lat,
      localeLng: locale.center_lng,
      listingTourSelected,
      listingPath: `${base}/listings/${listing.id}`,
      listingTourCalendarClient,
      listingSurfacePlan: snapshot.plan,
    }}
  >
    window.__WAYHOME_LISTING_PROX__ = {
      listingId,
      localeId,
      hasLocation,
      mapKey,
      mapId,
      localeLat,
      localeLng,
    };
    window.__WAYHOME_MAPS__ = { mapKey, mapId };
    window.__WAYHOME_LISTING_SURFACE__ = { plan: listingSurfacePlan, listingId, localeId };
    window.__WAYHOME_LISTING_TOUR_CAL__ = {
      localeId,
      listingId,
      selectedDate: listingTourSelected,
      listingPath,
      tourCalendar: listingTourCalendarClient,
    };
  </script>
  <DirectionsOverlay />
  <script src="/scripts/directions-overlay.js" type="module"></script>
  <script src="/scripts/listing-proximity.js" type="module"></script>
  <script src="/scripts/listing-detail.js" type="module"></script>
  <script src="/scripts/listing-tour-calendar.js" type="module"></script>
  <style>
    .proximity-panel {
      --prox-gap: 1.35rem;
      gap: var(--prox-gap);
      margin-block: 0;

      @media (min-width: 768px) {
        --prox-gap: 1.5rem;
      }
    }

    .proximity-panel label {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.95rem;
    }

    .proximity-panel .prox-lede {
      margin: 0;
      max-inline-size: 42rem;
      line-height: 1.55;
    }

    .proximity-panel .prox-fields {
      gap: 1.15rem;
      padding-block: 0.25rem;
    }

    .proximity-panel .prox-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-block: 0.5rem 0.15rem;
    }

    .prox-choices[hidden],
    .prox-result[hidden],
    .place-search__results[hidden],
    [data-place-search-error][hidden],
    #prox-nearest-fields[hidden],
    #prox-search-fields[hidden] {
      display: none;
    }

    .prox-places-lede {
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.45;

      & strong {
        font-weight: 600;
        color: var(--text);
      }

      & .prox-lede-accent {
        color: var(--primary);
      }
    }

    .prox-place-tag {
      display: inline-block;
      margin-block-start: 0.25rem;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .prox-place-tag--compare {
      color: var(--primary);
    }

    .prox-place-tag--listing {
      color: var(--accent);
    }

    .listing-row--static.prox-saved-item--compare {
      border-color: color-mix(in srgb, var(--primary) 45%, var(--border-accent));
      background: color-mix(in srgb, var(--primary) 10%, var(--glass-wash-strong));
    }

    .listing-row--static.prox-saved-item--listing {
      border-color: color-mix(in srgb, var(--accent) 40%, var(--border-accent));
      background: color-mix(in srgb, var(--accent) 8%, var(--glass-wash-strong));
    }

    .listing-row__actions {
      flex: 0 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      align-items: center;
      margin-block-start: 0;
    }

    .prox-saved-item__actions {
      margin-block-start: 0;
    }

    .prox-choices {
      gap: 0.65rem;
      padding-block-start: 0.25rem;
    }

    .prox-choice {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      text-align: start;
      inline-size: 100%;
      padding-block: 0.7rem;
      padding-inline: 0.9rem;
    }

    .prox-result {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-block: 0.5rem 0.25rem;
      line-height: 1.45;

      & p {
        margin: 0;
      }
    }

    .prox-result__name {
      font-size: 1.05rem;
      font-weight: 600;
    }

    .prox-result__meta {
      color: var(--text-muted);
      font-size: 0.95rem;
      font-variant-numeric: tabular-nums;
    }

    .prox-result__status {
      color: var(--text-muted);
    }

    .prox-result__status.is-error {
      color: var(--danger);
    }

    .listing-map {
      margin-block: 0;
    }
  </style>
</AppLayout>
