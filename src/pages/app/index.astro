---
import AppLayout from '../../layouts/AppLayout.astro';
import {
  ensureNestForUser,
  getPrimaryNestId,
  listLocalesForNest,
  localeNeedsSetup,
} from '../../lib/supabase/nest';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;

let nestId = await getPrimaryNestId(supabase, user.id);
if (!nestId) {
  nestId = await ensureNestForUser(supabase, user.id);
}

const { data: nest } = await supabase
  .from('nests')
  .select('id, name')
  .eq('id', nestId)
  .single();

const locales = await listLocalesForNest(supabase, nestId);
---
<AppLayout title={nest?.name ?? 'Nest'} crumbs={[{ label: nest?.name ?? 'Nest' }]}>
  <p class="muted">Signed in as {user.email}</p>

  <h1>{nest?.name ?? 'Nest'}</h1>
  <h2>Locales</h2>
  <p><a href="/app/locales/new">New Locale</a></p>
  {
    locales.length === 0 ? (
      <p class="muted">No Locales yet. Create one to start collecting listings.</p>
    ) : (
      <ul class="stack">
        {locales.map((locale) => (
          <li>
            <a href={`/app/locales/${locale.id}`}>{locale.name}</a>
            {localeNeedsSetup(locale) ? ' — Needs setup' : ''}
          </li>
        ))}
      </ul>
    )
  }
</AppLayout>
