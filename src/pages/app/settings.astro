---
import AppLayout from '../../layouts/AppLayout.astro';
import NestMemberList from '../../components/NestMemberList.astro';
import { generateInviteToken } from '../../lib/crypto/invite-token';
import { getPrimaryNestId, listNestMembers } from '../../lib/supabase/nest';
import type { NestMemberProfile } from '../../lib/types/database';
import { listUiThemes, resolveUiThemeId } from '../../lib/ui/themes';
import { resolveUiBorders } from '../../lib/ui/borders';

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase!;
const nestId = await getPrimaryNestId(supabase, user.id);
const themes = listUiThemes();

let inviteUrl: string | null = null;
let errorMessage = '';
let notice = '';

const { data: profile } = await supabase
  .from('profiles')
  .select('ui_theme_id, ui_show_borders')
  .eq('id', user.id)
  .maybeSingle();
const currentThemeId = resolveUiThemeId(profile?.ui_theme_id);
const bordersOn = resolveUiBorders(profile?.ui_show_borders) === 'on';

let nestMembers: NestMemberProfile[] = [];
if (nestId) {
  nestMembers = await listNestMembers(supabase, nestId);
}

if (!nestId) {
  errorMessage = 'No Nest found.';
} else if (Astro.request.method === 'POST') {
  const { raw, hash } = generateInviteToken();
  const { error } = await supabase
    .from('nests')
    .update({ invite_token_hash: hash })
    .eq('id', nestId);
  if (error) {
    errorMessage = error.message;
  } else {
    inviteUrl = `${Astro.url.origin}/invite/${raw}`;
    notice = 'Invite link rotated. Copy it now — the raw token is not stored.';
  }
}

const swatchVars: Record<string, { primary: string; accent: string }> = {
  sea: { primary: '#2dd4bf', accent: '#93c5fd' },
  steel: { primary: '#60a5fa', accent: '#c4b5fd' },
  sand: { primary: '#fbbf24', accent: '#fdba74' },
};

const defaultTab: 'theme' | 'members' | 'invite' = inviteUrl || notice ? 'invite' : 'theme';
---
<AppLayout title="Settings" crumbs={[{ href: '/app', label: 'Home' }, { label: 'Settings' }]}>
  <h1>Settings</h1>
  {errorMessage && <p class="alert" role="alert">{errorMessage}</p>}

  <div class="nest-tabs" data-nest-tabs>
    <nav
      class="locale-nav nest-tabs__bar"
      aria-label="Settings sections"
      data-nest-tabs-bar
      role="tablist"
    >
      <span class="locale-nav__pill" aria-hidden="true" data-nest-tabs-pill></span>
      <button
        type="button"
        class:list={[
          'button secondary locale-nav__link',
          defaultTab === 'theme' && 'locale-nav__link--active',
        ]}
        id="settings-tab-theme"
        role="tab"
        aria-selected={defaultTab === 'theme' ? 'true' : 'false'}
        aria-controls="settings-panel-theme"
        tabindex={defaultTab === 'theme' ? 0 : -1}
        data-nest-tab="theme"
      >
        Theme
      </button>
      <button
        type="button"
        class:list={[
          'button secondary locale-nav__link',
          defaultTab === 'members' && 'locale-nav__link--active',
        ]}
        id="settings-tab-members"
        role="tab"
        aria-selected={defaultTab === 'members' ? 'true' : 'false'}
        aria-controls="settings-panel-members"
        tabindex={defaultTab === 'members' ? 0 : -1}
        data-nest-tab="members"
      >
        Members
      </button>
      <button
        type="button"
        class:list={[
          'button secondary locale-nav__link',
          defaultTab === 'invite' && 'locale-nav__link--active',
        ]}
        id="settings-tab-invite"
        role="tab"
        aria-selected={defaultTab === 'invite' ? 'true' : 'false'}
        aria-controls="settings-panel-invite"
        tabindex={defaultTab === 'invite' ? 0 : -1}
        data-nest-tab="invite"
      >
        Invite
      </button>
    </nav>

    <div
      id="settings-panel-theme"
      class="nest-tabs__panel"
      role="tabpanel"
      aria-labelledby="settings-tab-theme"
      data-nest-tab-panel="theme"
      hidden={defaultTab !== 'theme' ? true : undefined}
    >
      <section class="stack theme-section">
        <h2 class="visually-hidden">Accent theme</h2>
        <div class="theme-swatches" id="theme-swatches" role="radiogroup" aria-label="Accent theme">
          {
            themes.map((theme) => {
              const swatch = swatchVars[theme.id] ?? {
                primary: 'var(--primary)',
                accent: 'var(--accent)',
              };
              return (
                <label
                  class="theme-swatch"
                  style={`--swatch-primary:${swatch.primary};--swatch-accent:${swatch.accent}`}
                >
                  <input
                    type="radio"
                    name="ui_theme_id"
                    value={theme.id}
                    checked={theme.id === currentThemeId}
                  />
                  <span class="theme-swatch__dots" aria-hidden="true">
                    <span class="theme-swatch__dot" title="Primary"></span>
                    <span class="theme-swatch__dot theme-swatch__dot--accent" title="Accent"></span>
                  </span>
                  {theme.label}
                </label>
              );
            })
          }
        </div>
        <label class="theme-borders">
          <input
            type="checkbox"
            id="ui-show-borders"
            name="ui_show_borders"
            checked={bordersOn}
          />
          <span>Show borders</span>
        </label>
        <p id="theme-status" class="theme-status muted" aria-live="polite"></p>
      </section>
    </div>

    <div
      id="settings-panel-members"
      class="nest-tabs__panel"
      role="tabpanel"
      aria-labelledby="settings-tab-members"
      data-nest-tab-panel="members"
      hidden={defaultTab !== 'members' ? true : undefined}
    >
      {
        nestId ? (
          <NestMemberList members={nestMembers} currentUserId={user.id} showHeading={false} />
        ) : (
          <p class="muted">No Nest found.</p>
        )
      }
    </div>

    <div
      id="settings-panel-invite"
      class="nest-tabs__panel"
      role="tabpanel"
      aria-labelledby="settings-tab-invite"
      data-nest-tab-panel="invite"
      hidden={defaultTab !== 'invite' ? true : undefined}
    >
      <section class="stack invite-section">
        {notice && <p class="muted">{notice}</p>}
        {
          inviteUrl && (
            <div id="invite-copy" class="invite-copy stack">
              <label class="invite-copy__label" for="invite-url">
                Invite link <span class="muted">(click to copy)</span>
              </label>
              <div class="invite-copy__row">
                <input
                  id="invite-url"
                  class="invite-copy__input"
                  type="text"
                  readonly
                  value={inviteUrl}
                  data-invite-url
                />
                <button type="button" class="button secondary" data-copy-invite>
                  Copy
                </button>
              </div>
              <p id="invite-copy-status" class="invite-copy__status muted" aria-live="polite"></p>
            </div>
          )
        }
        {
          nestId ? (
            <form method="post">
              <button type="submit">Generate invite link</button>
            </form>
          ) : (
            <p class="muted">No Nest found.</p>
          )
        }
      </section>
    </div>
  </div>

  <script src="/scripts/nest-tabs.js" type="module"></script>
  <script src="/scripts/settings-invite.js" type="module"></script>
  <script>
    const status = document.getElementById('theme-status');
    const group = document.getElementById('theme-swatches');
    const borders = document.getElementById('ui-show-borders');

    group?.addEventListener('change', async (e) => {
      const target = e.target;
      if (!(target instanceof HTMLInputElement) || target.name !== 'ui_theme_id') return;
      const ui_theme_id = target.value;
      document.documentElement.dataset.theme = ui_theme_id;
      if (status) status.textContent = 'Saving…';
      try {
        const res = await fetch('/api/profile/theme', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ui_theme_id }),
        });
        const data = await res.json();
        if (!res.ok) {
          if (status) status.textContent = data.error || 'Could not save theme';
          return;
        }
        if (status) status.textContent = '';
      } catch {
        if (status) status.textContent = 'Could not save theme';
      }
    });

    borders?.addEventListener('change', async () => {
      if (!(borders instanceof HTMLInputElement)) return;
      const ui_show_borders = borders.checked;
      document.documentElement.dataset.uiBorders = ui_show_borders ? 'on' : 'off';
      if (status) status.textContent = 'Saving…';
      try {
        const res = await fetch('/api/profile/borders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ui_show_borders }),
        });
        const data = await res.json();
        if (!res.ok) {
          if (status) status.textContent = data.error || 'Could not save border preference';
          return;
        }
        if (status) status.textContent = '';
      } catch {
        if (status) status.textContent = 'Could not save border preference';
      }
    });
  </script>
  <style>
    .theme-borders {
      --borders-gap: 0.65rem;

      display: inline-flex;
      align-items: center;
      gap: var(--borders-gap);
      margin: 0;
      font-size: 0.95rem;
      cursor: pointer;

      & input {
        inline-size: 1.1rem;
        block-size: 1.1rem;
        margin: 0;
        accent-color: var(--primary);
      }
    }
  </style>
</AppLayout>
