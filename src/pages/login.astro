---
import AuthLayout from '../layouts/AuthLayout.astro';
import { getDemoVisitorToken } from '../lib/demo/nest';
import { tokensMatch } from '../lib/demo/session';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { ensureNestForUser, isInviteRedirect } from '../lib/supabase/nest';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();

const redirectTo = Astro.url.searchParams.get('redirect') || '/app';
const entryToken = Astro.url.searchParams.get('v') ?? '';

if (user) {
  return Astro.redirect(redirectTo);
}

const demoEntryOk =
  Boolean(entryToken) && tokensMatch(getDemoVisitorToken(), entryToken);

let errorMessage = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');
  const { data, error } = await supabase.auth.signInWithPassword({ email, password });
  if (error) {
    errorMessage = error.message;
  } else if (data.user) {
    try {
      if (!isInviteRedirect(redirectTo)) {
        await ensureNestForUser(supabase, data.user.id);
      }
      return Astro.redirect(redirectTo);
    } catch (e) {
      errorMessage = e instanceof Error ? e.message : 'Could not create Nest';
    }
  }
}

const signupHref = `/signup?redirect=${encodeURIComponent(redirectTo)}`;
---
<AuthLayout title="Sign in">
  <h1>Sign in</h1>
  <p
    class="alert"
    role="alert"
    data-login-error
    hidden={!errorMessage}
  >
    {errorMessage}
  </p>
  <form method="post" class="stack" data-login-form>
    <label>Email <input type="email" name="email" required /></label>
    <label>Password <input type="password" name="password" required /></label>
    <button type="submit">Sign in</button>
  </form>
  <p><a href={signupHref}>Need an account? Sign up</a></p>
  {
    demoEntryOk && (
      <script is:inline>
        document.documentElement.dataset.demoEntry = '1';
      </script>
    )
  }
  {
    demoEntryOk && (
      <script>
        import '../client/login-demo-theater';
      </script>
    )
  }
</AuthLayout>
