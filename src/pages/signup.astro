---
import { createSupabaseServerClient } from '../lib/supabase/server';
import { ensureWorkspaceForUser } from '../lib/supabase/workspace';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();
if (user) {
  return Astro.redirect('/app');
}

let errorMessage = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');
  const { data, error } = await supabase.auth.signUp({ email, password });
  if (error) {
    errorMessage = error.message;
  } else if (data.user) {
    await ensureWorkspaceForUser(supabase, data.user.id);
    return Astro.redirect('/app');
  } else {
    errorMessage = 'Check your email to confirm signup, then sign in.';
  }
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sign up — Real Estate Mapper</title>
  </head>
  <body>
    <h1>Sign up</h1>
    {errorMessage && <p role="alert">{errorMessage}</p>}
    <form method="post">
      <label>Email <input type="email" name="email" required /></label>
      <label>Password <input type="password" name="password" required minlength="8" /></label>
      <button type="submit">Create account</button>
    </form>
    <p><a href="/login">Already have an account? Sign in</a></p>
  </body>
</html>
