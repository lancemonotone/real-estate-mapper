---
import '../styles/tokens.css';
import '../styles/chrome.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import { DEFAULT_UI_THEME_ID } from '../lib/ui/themes';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={DEFAULT_UI_THEME_ID}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SiteFavicon />
    <title>{title} — Wayhome</title>
  </head>
  <body class="app-shell">
    <header class="app-header glass">
      <a class="app-header__brand" href="/">Wayhome</a>
    </header>
    <main class="app-main glass panel">
      <slot />
    </main>
    <SpeedInsights />
  </body>
</html>
