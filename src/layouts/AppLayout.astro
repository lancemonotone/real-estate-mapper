---
import '../styles/tokens.css';
import '../styles/chrome.css';
import { resolveUiThemeId } from '../lib/ui/themes';

type Crumb = { href?: string; label: string };

interface Props {
  title: string;
  crumbs?: Crumb[];
}

const { title, crumbs = [] } = Astro.props;
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

let themeId = resolveUiThemeId(null);
if (user && supabase) {
  const { data: profile } = await supabase
    .from('profiles')
    .select('ui_theme_id')
    .eq('id', user.id)
    .maybeSingle();
  themeId = resolveUiThemeId(profile?.ui_theme_id);
}
---
<!doctype html>
<html lang="en" data-theme={themeId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — Wayhome</title>
  </head>
  <body class="app-shell">
    <header class="app-header glass glass--strong">
      <a class="app-header__brand" href="/app">Wayhome</a>
      {
        crumbs.length > 0 && (
          <nav class="app-header__crumbs" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> / </span>}
                {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <nav class="app-header__nav" aria-label="App">
        <a href="/app">Nest</a>
        <a href="/app/settings">Settings</a>
        <form method="post" action="/api/auth/logout" style="display:inline;margin:0">
          <button type="submit" class="secondary">Sign out</button>
        </form>
      </nav>
    </header>
    <main class="app-main glass panel">
      <slot />
    </main>
  </body>
</html>
