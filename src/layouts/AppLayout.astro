---
import '../styles/tokens.css';
import '../styles/chrome.css';
import '../styles/ui-borders-off.css';
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import { resolveUiBorders } from '../lib/ui/borders';
import { resolveUiThemeId } from '../lib/ui/themes';
import LocaleNav from '../components/LocaleNav.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import type { LocaleNavSection } from '../lib/ui/locale-nav';

type Crumb = { href?: string; label: string };

interface Props {
  title: string;
  crumbs?: Crumb[];
  /** When set, renders Locale section nav above page content. */
  locale?: { id: string; name: string };
  localeSection?: LocaleNavSection;
}

const { title, crumbs = [], locale, localeSection = 'listings' } = Astro.props;
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

let themeId = resolveUiThemeId(null);
let bordersMode = resolveUiBorders(true);
if (user && supabase) {
  const { data: profile } = await supabase
    .from('profiles')
    .select('ui_theme_id, ui_show_borders')
    .eq('id', user.id)
    .maybeSingle();
  themeId = resolveUiThemeId(profile?.ui_theme_id);
  bordersMode = resolveUiBorders(profile?.ui_show_borders);
}
---
<!doctype html>
<html lang="en" data-theme={themeId} data-ui-borders={bordersMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SiteFavicon />
    <title>{title} — Wayhome</title>
    <ClientRouter />
  </head>
  <body class="app-shell">
    <header class="app-header glass">
      <a class="app-header__brand" href="/app">Wayhome</a>
      {
        crumbs.length > 0 && (
          <nav class="app-header__crumbs" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="app-header__crumbs-sep" aria-hidden="true"> / </span>}
                {c.href ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span class="app-header__crumbs-current">{c.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }
      <nav class="app-header__nav" aria-label="App">
        <a
          class="secondary icon-btn"
          href="/app/settings"
          title="Settings"
          aria-label="Settings"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="3"></circle>
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
            ></path>
          </svg>
        </a>
        <form method="post" action="/api/auth/logout" class="app-header__logout">
          <button
            type="submit"
            class="secondary icon-btn"
            title="Sign out"
            aria-label="Sign out"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <path d="M16 17l5-5-5-5"></path>
              <path d="M21 12H9"></path>
            </svg>
          </button>
        </form>
      </nav>
    </header>
    <main class="app-main glass panel">
      {
        locale && (
          <div
            class="locale-nav-wrap"
            transition:persist={`locale-nav-${locale.id}`}
          >
            <LocaleNav
              localeId={locale.id}
              localeName={locale.name}
              current={localeSection}
            />
          </div>
        )
      }
      <div class="app-main__view" transition:animate="fade">
        <slot />
      </div>
    </main>
    {locale && <script src="/scripts/locale-nav.js" type="module"></script>}
    <script src="/scripts/listing-favorite.js" type="module"></script>
    <SpeedInsights />
  </body>
</html>
