---
import '../styles/tokens.css';
import '../styles/chrome.css';
import '../styles/ui-borders-off.css';
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import { resolveUiBorders } from '../lib/ui/borders';
import { resolveUiThemeId } from '../lib/ui/themes';
import IconGlyph from '../components/IconGlyph.astro';
import LocaleNav from '../components/LocaleNav.astro';
import NestEntitlementBanner from '../components/NestEntitlementBanner.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import type { NestEntitlementUi } from '../lib/nest/entitlements/ui-context';
import { loadNestEntitlementUi } from '../lib/nest/entitlements/ui-context';
import type { LocaleNavSection } from '../lib/ui/locale-nav';

type Crumb = { href?: string; label: string };

interface Props {
  title: string;
  crumbs?: Crumb[];
  /** When set, renders Locale section nav above page content. */
  locale?: { id: string; name: string };
  localeSection?: LocaleNavSection;
  /** Load entitlement banner for this Nest when ui is not passed. */
  nestId?: string;
  entitlementUi?: NestEntitlementUi | null;
}

const {
  title,
  crumbs = [],
  locale,
  localeSection = 'listings',
  nestId,
  entitlementUi: entitlementUiProp,
} = Astro.props;
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const devHuntPassPreview = Astro.locals.devHuntPassPreview ?? false;

let entitlementUi = entitlementUiProp ?? null;
if (!entitlementUi && nestId && user && supabase) {
  entitlementUi = await loadNestEntitlementUi(
    supabase,
    nestId,
    user.id,
    Astro.locals.devHuntPassPreview ?? false,
  );
}

let themeId = resolveUiThemeId(null);
let bordersMode = resolveUiBorders(true);
const profile = Astro.locals.profile;
if (profile) {
  themeId = resolveUiThemeId(profile.ui_theme_id);
  bordersMode = resolveUiBorders(profile.ui_show_borders);
} else if (user && supabase) {
  const { data: loadedProfile } = await supabase
    .from('profiles')
    .select('ui_theme_id, ui_show_borders')
    .eq('id', user.id)
    .maybeSingle();
  themeId = resolveUiThemeId(loadedProfile?.ui_theme_id);
  bordersMode = resolveUiBorders(loadedProfile?.ui_show_borders);
}
---
<!doctype html>
<html lang="en" data-theme={themeId} data-ui-borders={bordersMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SiteFavicon />
    <title>{title} — Wayhome</title>
    <ClientRouter />
  </head>
  <body class="app-shell">
    <header class="app-header glass">
      <a class="app-header__brand" href="/app">Wayhome</a>
      {
        crumbs.length > 0 && (
          <nav class="app-header__crumbs" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="app-header__crumbs-sep" aria-hidden="true"> / </span>}
                {c.href ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span class="app-header__crumbs-current">{c.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }
      <nav class="app-header__nav" aria-label="App">
        {
          devHuntPassPreview && (
            <a
              class="badge badge--accent app-header__dev-preview"
              href="/app/settings"
              title="Hunt Pass preview is on. Open Settings to turn off."
            >
              Hunt Pass preview
            </a>
          )
        }
        <a
          class="secondary icon-btn"
          href="/app/settings"
          title="Settings"
          aria-label="Settings"
        >
          <IconGlyph name="settings" />
        </a>
        <form method="post" action="/api/auth/logout" class="app-header__logout">
          <button
            type="submit"
            class="secondary icon-btn"
            title="Sign out"
            aria-label="Sign out"
          >
            <IconGlyph name="logOut" />
          </button>
        </form>
      </nav>
    </header>
    <main class="app-main glass panel">
      {
        locale && (
          <div
            class="locale-nav-wrap"
            transition:persist={`locale-nav-${locale.id}`}
          >
            <LocaleNav
              localeId={locale.id}
              localeName={locale.name}
              current={localeSection}
            />
          </div>
        )
      }
      <div class="app-main__view" transition:animate="fade">
        {entitlementUi && <NestEntitlementBanner ui={entitlementUi} />}
        <slot />
      </div>
    </main>
    {locale && <script src="/scripts/locale-nav.js" type="module"></script>}
    <script src="/scripts/listing-favorite.js" type="module"></script>
    {locale && <script src="/scripts/favorites-filter.js" type="module"></script>}
    <script>
      import '../client/listing-gallery';
      import '../client/listing-gallery-form';
      import '../client/listing-form-autosave';
      import '../client/listing-detail-sync';
    </script>
    <SpeedInsights />
  </body>
</html>
